---
/**
 * LoadingScreen - the pen tool draws the "HU." monogram, then the screen slides away.
 *
 * Matches the site's pen-tool language (see PenToolPath.astro): a blue nib inks each stroke of
 * the H and U, drops Bezier anchors with handles on the way, and places the period as a selected
 * (filled) square anchor that settles into the round blue dot. Drawing ends ~1.15s after start,
 * the exit takes ~0.45s, and the exit never waits on images past `fallbackTimeout`.
 *
 * Shows once per browser session ('loaderShown') and never when returning from a case study
 * ('scrollToSection').
 */
---

<div id="loading-screen" class="loading-screen" aria-hidden="true">
  <!-- Background that slides up (with a curved trailing edge) -->
  <div class="loader-bg" id="loader-bg"></div>

  <div class="loader-content" id="loader-content">
    <svg viewBox="0 0 100 100" class="logo-svg" id="loader-svg">
      <!-- Finished monogram strokes (same geometry as public/favicon.svg), one path per stroke -->
      <g class="logo-reveal" id="logo-reveal">
        <path class="mono-stroke" pathLength="1" d="M10 25 L10 75" />
        <path class="mono-stroke" pathLength="1" d="M10 50 L26 50" />
        <path class="mono-stroke" pathLength="1" d="M26 25 L26 75" />
        <path class="mono-stroke" pathLength="1" d="M42 25 L42 60 Q42 75 58 75 L58 25" />
      </g>
      <!-- Pen ink: the thin blue path the nib lays down ahead of each stroke -->
      <g class="ink-layer" id="ink-layer">
        <path class="ink-stroke" pathLength="1" d="M10 25 L10 75" />
        <path class="ink-stroke" pathLength="1" d="M10 50 L26 50" />
        <path class="ink-stroke" pathLength="1" d="M26 25 L26 75" />
        <path class="ink-stroke" pathLength="1" d="M42 25 L42 60 Q42 75 58 75 L58 25" />
      </g>
      <g id="loader-anchors"></g>
      <!-- The period: starts as a selected square anchor, settles into the dot -->
      <rect class="mono-dot" id="mono-dot" x="72" y="60" width="16" height="16" rx="8" />
      <g class="pen-nib" id="loader-nib" opacity="0">
        <path d="M0 0 L-9 -22 L0 -32 L9 -22 Z" />
        <circle cx="0" cy="-18" r="2.4" />
        <line x1="0" y1="-18" x2="0" y2="-3" />
      </g>
    </svg>
  </div>
</div>

<!-- Hide before first paint when the loader will be skipped, so it never flashes -->
<script is:inline>
  try {
    if (sessionStorage.getItem('scrollToSection') || sessionStorage.getItem('loaderShown')) {
      document.getElementById('loading-screen').style.display = 'none';
    }
  } catch (e) {}
</script>

<style>
  .loading-screen {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: all;
    overflow: hidden;
    /* Failsafe: if the script never runs, get out of the way after 3s */
    animation: loader-failsafe 0.3s ease 3s forwards;
  }

  @keyframes loader-failsafe {
    to { opacity: 0; visibility: hidden; pointer-events: none; }
  }

  .loading-screen.hidden {
    pointer-events: none;
  }

  .loader-bg {
    position: absolute;
    inset: 0;
    background: var(--color-bg, #0C0C0C);
    z-index: 1;
    will-change: transform;
  }

  /* Curved trailing edge, hidden below the viewport until the slide-up */
  .loader-bg::after {
    content: '';
    position: absolute;
    left: -10%;
    right: -10%;
    top: calc(100% - 1px);
    height: 16vh;
    background: inherit;
    clip-path: ellipse(50% 100% at 50% 0%);
  }

  .loader-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-svg {
    display: block;
    width: clamp(140px, 40vw, 200px);
    height: clamp(140px, 40vw, 200px);
    overflow: visible;
    color: var(--color-fg, #F5F5F0);
  }

  .mono-stroke {
    fill: none;
    stroke: currentColor;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .ink-stroke {
    fill: none;
    stroke: #4A5EE4;
    stroke-width: 1.1; /* set to 2.2 screen px in the script */
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .mono-dot {
    fill: var(--color-accent, #4a5ee4);
    opacity: 0;
  }

  .pen-nib path {
    fill: #4A5EE4;
    stroke: #fff;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .pen-nib circle { fill: #fff; }
  .pen-nib line { stroke: #fff; stroke-width: 1.2; }

  /* Reduced motion: the finished monogram, no drawing */
  @media (prefers-reduced-motion: reduce) {
    .mono-stroke { stroke-dashoffset: 0; }
    .ink-layer,
    .pen-nib { display: none; }
    .mono-dot { opacity: 1; }
  }
</style>

<script>
  import gsap from 'gsap';

  const SVG_NS = 'http://www.w3.org/2000/svg';
  const INK = '#4A5EE4';
  // Drawing settles at ~1.15s; the exit (~0.45s) brings the visible total to ~1.6s.
  const HARD_CAP_MS = 1150;

  function initLoadingScreen() {
    const loadingScreen = document.getElementById('loading-screen');
    const loaderBg = document.getElementById('loader-bg');
    const loaderContent = document.getElementById('loader-content');
    const svg = document.getElementById('loader-svg') as unknown as SVGSVGElement | null;
    const logoReveal = document.getElementById('logo-reveal');
    const inkLayer = document.getElementById('ink-layer');
    const anchorsG = document.getElementById('loader-anchors');
    const dot = document.getElementById('mono-dot');
    const nib = document.getElementById('loader-nib');

    if (!loadingScreen || !loaderBg || !loaderContent || !svg || !logoReveal || !inkLayer || !anchorsG || !dot || !nib) return;

    // Skip loading screen when returning from case study, or if it already played this session
    // (e.g. pressing the browser back button reloads the home page)
    const returningFromCaseStudy = sessionStorage.getItem('scrollToSection');
    if (returningFromCaseStudy || sessionStorage.getItem('loaderShown')) {
      loadingScreen.style.display = 'none';
      return;
    }
    sessionStorage.setItem('loaderShown', '1');

    // The script is running, so the CSS failsafe is no longer needed
    loadingScreen.style.animation = 'none';

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const customEase = 'cubic-bezier(0.65, 0.01, 0.05, 0.99)';

    // ---- Image loading progress (gates the exit, but never past fallbackTimeout) ----
    let currentProgress = 0;
    let targetProgress = 0;
    let drawingSettled = false;
    let isComplete = false;

    const images = Array.from(document.images);
    const totalResources = Math.max(images.length, 1);
    let loadedResources = 0;
    const updateProgress = () => {
      // Never move backwards (the fallback may already have forced 100)
      const pct = Math.min(Math.round(((loadedResources + 1) / (totalResources + 1)) * 100), 100);
      targetProgress = Math.max(targetProgress, pct);
    };
    updateProgress();
    images.forEach(img => {
      if (img.complete) {
        loadedResources++;
        updateProgress();
      } else {
        img.addEventListener('load', () => { loadedResources++; updateProgress(); }, { once: true });
        img.addEventListener('error', () => { loadedResources++; updateProgress(); }, { once: true });
      }
    });
    if (loadedResources >= images.length) targetProgress = 100;

    // The drawing is the loader: never hold the page beyond the drawing's own length
    // (a hard cap, so it skips the easing too)
    const fallbackTimeout = setTimeout(() => { targetProgress = 100; currentProgress = 100; }, HARD_CAP_MS);

    const trackProgress = () => {
      if (isComplete) return;
      currentProgress += (targetProgress - currentProgress) * 0.35;
      if (targetProgress - currentProgress < 1) currentProgress = targetProgress;
      if (currentProgress >= 100 && drawingSettled) {
        isComplete = true;
        clearTimeout(fallbackTimeout);
        completeLoading();
        return;
      }
      requestAnimationFrame(trackProgress);
    };

    // trackProgress keeps polling each frame; once the drawing settles it can hand off to the exit
    const settle = () => { drawingSettled = true; };

    const hideOverlay = () => {
      loadingScreen.classList.add('hidden');
      loadingScreen.style.display = 'none';
    };

    // ---- Exit: the background slides up with a curved trailing edge, carrying the monogram ----
    const completeLoading = () => {
      if (prefersReducedMotion) {
        gsap.to(loadingScreen, { opacity: 0, duration: 0.25, ease: 'power1.out', onComplete: hideOverlay });
        return;
      }
      gsap.timeline({ onComplete: hideOverlay })
        .to(loaderBg, { yPercent: -118, duration: 0.45, ease: customEase }, 0)
        // The monogram rides up with the curtain, so it never sits over the revealed page
        .to(loaderContent, { y: () => -window.innerHeight * 1.18, duration: 0.45, ease: customEase }, 0)
        .to(loaderContent, { opacity: 0, duration: 0.3, ease: 'power1.in' }, 0.1);
    };

    if (prefersReducedMotion) {
      // Finished monogram (set by CSS), shown briefly, then a simple fade
      requestAnimationFrame(trackProgress);
      setTimeout(settle, 450);
      return;
    }

    // ---- Pen-tool drawing ----
    const monoStrokes = Array.from(logoReveal.querySelectorAll<SVGPathElement>('path'));
    const inkStrokes = Array.from(inkLayer.querySelectorAll<SVGPathElement>('path'));
    if (monoStrokes.length !== 4 || inkStrokes.length !== 4) { hideOverlay(); return; }

    // Pixels per SVG unit, so the nib and anchors match PenToolPath's on-screen sizes
    const k = (svg.getBoundingClientRect().width || 180) / 100;
    const compact = window.innerWidth < 768;
    const px = 1 / k;
    const nibScale = (compact ? 0.8 : 1) * px;
    // Ink line in screen px, like PenToolPath (2.2, or 1.6 on phones). Not vector-effect:
    // non-scaling strokes break the pathLength-based dashes.
    inkStrokes.forEach((p) => { p.style.strokeWidth = String((compact ? 1.6 : 2.2) * px); });

    const nibState = { x: 10, y: 25, r: 180, s: 1 };
    const renderNib = () => {
      nib.setAttribute(
        'transform',
        `translate(${nibState.x} ${nibState.y}) rotate(${nibState.r}) scale(${nibScale * nibState.s})`
      );
    };

    // Direction of travel along a path at length l -> nib rotation (same convention as PenToolPath)
    const angleAt = (path: SVGPathElement, l: number, total: number) => {
      const a = path.getPointAtLength(Math.max(0, Math.min(total, l)));
      const b = path.getPointAtLength(Math.max(0, Math.min(total, l + 0.6)));
      const back = l + 0.6 > total;
      const dx = back ? a.x - path.getPointAtLength(total - 0.6).x : b.x - a.x;
      const dy = back ? a.y - path.getPointAtLength(total - 0.6).y : b.y - a.y;
      return (Math.atan2(dy, dx) * 180) / Math.PI + 90;
    };
    // Keep rotation continuous (no spinning the long way round)
    const nearestAngle = (from: number, to: number) => {
      const d = ((to - from) % 360 + 540) % 360 - 180;
      return from + d;
    };

    // Bezier anchor with handles along the tangent, built in screen pixels then scaled into the SVG
    type Anchor = { g: SVGGElement; handles: SVGGElement };
    const makeAnchor = (x: number, y: number, tangentDeg: number): Anchor => {
      const reach = compact ? 16 : 22;
      const g = document.createElementNS(SVG_NS, 'g') as SVGGElement;
      g.setAttribute('transform', `translate(${x} ${y}) scale(${px})`);
      g.setAttribute('opacity', '0');
      const handles = document.createElementNS(SVG_NS, 'g') as SVGGElement;
      handles.setAttribute('transform', `rotate(${tangentDeg}) scale(0 1)`);
      handles.innerHTML =
        `<line x1="${-reach}" y1="0" x2="${reach}" y2="0" stroke="${INK}" stroke-width="1"/>` +
        `<circle cx="${-reach}" cy="0" r="4" fill="${INK}"/>` +
        `<circle cx="${reach}" cy="0" r="4" fill="${INK}"/>`;
      g.appendChild(handles);
      const sq = document.createElementNS(SVG_NS, 'rect');
      sq.setAttribute('x', '-6');
      sq.setAttribute('y', '-6');
      sq.setAttribute('width', '12');
      sq.setAttribute('height', '12');
      sq.setAttribute('fill', '#fff');
      sq.setAttribute('stroke', INK);
      sq.setAttribute('stroke-width', '2');
      g.appendChild(sq);
      anchorsG.appendChild(g);
      return { g, handles };
    };

    // Pop an anchor in, pull its handles out, then fade it away
    const playAnchor = (a: Anchor, tangentDeg: number) => {
      const h = { sx: 0 };
      gsap.to(a.g, { attr: { opacity: 1 }, duration: 0.08, ease: 'none' });
      gsap.to(h, {
        sx: 1, duration: 0.18, ease: 'back.out(2)',
        onUpdate: () => a.handles.setAttribute('transform', `rotate(${tangentDeg}) scale(${h.sx} 1)`),
      });
      gsap.to(a.g, { attr: { opacity: 0 }, duration: 0.18, delay: 0.26, ease: 'power1.in' });
    };

    // Anchor 1: middle of the H crossbar. Anchor 2: middle of the U's curve, where
    // Q(42,60 / 42,75 / 58,75) at t=0.5 is (46, 71.25) with tangent (16, 15).
    const anchorDefs = [
      { stroke: 1, x: 18, y: 50, tangent: 0 },
      { stroke: 3, x: 46, y: 71.25, tangent: (Math.atan2(15, 16) * 180) / Math.PI },
    ];
    const anchorAt = anchorDefs.map((def) => {
      const path = inkStrokes[def.stroke];
      const total = path.getTotalLength();
      // Fraction of the stroke where the nib passes the anchor
      let best = 0, bestD = Infinity;
      for (let l = 0; l <= total; l += 0.25) {
        const p = path.getPointAtLength(l);
        const d = Math.hypot(p.x - def.x, p.y - def.y);
        if (d < bestD) { bestD = d; best = l; }
      }
      return { ...def, frac: best / total, anchor: makeAnchor(def.x, def.y, def.tangent), shown: false };
    });

    const tl = gsap.timeline({ paused: true });

    // Nib arrives at the first point
    renderNib();
    tl.fromTo(nib, { attr: { opacity: 0 } }, { attr: { opacity: 1 }, duration: 0.12, ease: 'none' }, 0);
    tl.from(nibState, { y: 17, duration: 0.14, ease: 'power2.out', onUpdate: renderNib }, 0);

    // Each stroke: lift and travel to its start, then ink it with the nib riding the tip
    const strokePlan = [
      { dur: 0.14, ease: 'power2.inOut' },
      { dur: 0.09, ease: 'power2.inOut' },
      { dur: 0.13, ease: 'power2.inOut' },
      { dur: 0.26, ease: 'power1.inOut' },
    ];
    const TRAVEL = 0.05;
    const TRAIL = 0.05; // the light stroke follows the ink this far behind
    let t = 0.04;

    strokePlan.forEach((plan, i) => {
      const ink = inkStrokes[i];
      const mono = monoStrokes[i];
      const total = ink.getTotalLength();
      const start = ink.getPointAtLength(0);
      const startAngle = angleAt(ink, 0, total);

      if (i > 0) {
        tl.to(nibState, {
          x: start.x, y: start.y,
          r: () => nearestAngle(nibState.r, startAngle),
          duration: TRAVEL, ease: 'power2.inOut', onUpdate: renderNib,
        }, t);
        t += TRAVEL;
      } else {
        nibState.r = startAngle;
      }

      const prog = { p: 0 };
      tl.to(prog, {
        p: 1, duration: plan.dur, ease: plan.ease,
        onUpdate: () => {
          ink.style.strokeDashoffset = String(1 - prog.p);
          const l = prog.p * total;
          const pt = ink.getPointAtLength(l);
          nibState.x = pt.x;
          nibState.y = pt.y;
          nibState.r = nearestAngle(nibState.r, angleAt(ink, l, total));
          renderNib();
          anchorAt.forEach((a) => {
            if (a.stroke === i && !a.shown && prog.p >= a.frac) {
              a.shown = true;
              playAnchor(a.anchor, a.tangent);
            }
          });
        },
      }, t);
      tl.to(mono, { strokeDashoffset: 0, duration: plan.dur, ease: plan.ease }, t + TRAIL);
      t += plan.dur;
    });

    // The period: nib travels over, clicks, and leaves a selected square anchor
    const sq = { s: 12 * px, r: 0 };
    const renderDot = () => {
      dot.setAttribute('x', String(80 - sq.s / 2));
      dot.setAttribute('y', String(68 - sq.s / 2));
      dot.setAttribute('width', String(sq.s));
      dot.setAttribute('height', String(sq.s));
      dot.setAttribute('rx', String(sq.r));
    };
    renderDot();

    tl.to(nibState, {
      x: 80, y: 68, r: () => nearestAngle(nibState.r, 30),
      duration: 0.07, ease: 'power2.inOut', onUpdate: renderNib,
    }, t);
    t += 0.07;
    // Press
    tl.to(nibState, { s: 0.88, duration: 0.05, yoyo: true, repeat: 1, ease: 'power1.inOut', onUpdate: renderNib }, t);
    tl.set(dot, { opacity: 1 }, t + 0.03);
    tl.fromTo(sq, { s: 0 }, { s: 12 * px, duration: 0.08, ease: 'back.out(3)', onUpdate: renderDot }, t + 0.03);
    // Nib lifts away, up and to the right
    tl.to(nibState, { x: 92, y: 56, duration: 0.18, ease: 'power2.in', onUpdate: renderNib }, t + 0.1);
    tl.to(nib, { attr: { opacity: 0 }, duration: 0.14, ease: 'none' }, t + 0.12);
    // Square anchor settles into the round dot; the blue ink fades so the monogram reads clean
    tl.to(sq, { s: 16, r: 8, duration: 0.22, ease: 'back.out(1.6)', onUpdate: renderDot }, t + 0.11);
    tl.to([inkLayer, anchorsG], { opacity: 0, duration: 0.2, ease: 'power1.out' }, t + 0.02);

    // Hand off to the exit as the dot finishes settling (~1.1s in)
    tl.call(settle, [], Math.min(t + 0.24, HARD_CAP_MS / 1000));

    requestAnimationFrame(trackProgress);
    tl.play(0);
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLoadingScreen);
  } else {
    initLoadingScreen();
  }
</script>
