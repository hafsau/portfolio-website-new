---
/**
 * EasterEgg - "Press P" pen mode.
 *
 * P is the pen-tool shortcut in Figma. Pressing it anywhere on the site (outside form fields)
 * turns the page into a canvas: click to drop anchor points, press and drag to pull symmetric
 * bezier handles, click the first anchor (or press Enter) to close the shape. Esc or P exits.
 *
 * Visuals match PenToolPath.astro: #4A5EE4 ink, 2.2px round strokes, 12px white square anchors,
 * thin handles ending in r=4 dots, and the same pen nib glyph (used here as the cursor).
 *
 * Desktop only (fine pointer + hover). The drawing overlay is created on demand and removed on
 * exit, so nothing is left behind when pen mode is off.
 */
---

<div class="pm-toast" id="pen-mode-toast" role="status" aria-live="polite"></div>

<style is:global>
  .pm-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 99998;
    pointer-events: auto;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
    overflow: visible;
  }

  .pm-overlay.pm-leaving {
    pointer-events: none;
  }

  .pm-shape-path {
    stroke: #4A5EE4;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
  }

  .pm-shape-path.pm-closed {
    fill: rgba(74, 94, 228, 0.15);
  }

  .pm-preview {
    fill: none;
    stroke: #4A5EE4;
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0.6;
  }

  html.pm-active #cursor-dot {
    visibility: hidden !important;
  }

  .pm-toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 99999;
    display: flex;
    align-items: center;
    gap: 0.6em;
    max-width: calc(100vw - 32px);
    padding: 10px 18px;
    border-radius: 999px;
    background: #0C0C0C;
    color: #F5F5F0;
    font-family: "Space Grotesk", system-ui, -apple-system, sans-serif;
    font-size: 13px;
    line-height: 1.3;
    white-space: nowrap;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(245, 245, 240, 0.08);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 8px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.2s;
  }

  .pm-toast.pm-visible {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s;
  }

  .pm-toast kbd {
    display: inline-block;
    min-width: 1.6em;
    padding: 1px 6px;
    border-radius: 5px;
    background: rgba(245, 245, 240, 0.12);
    color: #F5F5F0;
    font-family: "JetBrains Mono", "SF Mono", monospace;
    font-size: 11.5px;
    text-align: center;
  }

  .pm-toast .pm-sep {
    color: rgba(245, 245, 240, 0.35);
  }

  .pm-toast .pm-title {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .pm-toast,
    .pm-toast.pm-visible {
      transition: none;
      transform: translate(-50%, 0);
    }
  }
</style>

<script>
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const INK = '#4A5EE4';
  const CLOSE_RADIUS = 9; // px distance to the first anchor that counts as "close the path"
  const DRAG_THRESHOLD = 3; // px of movement before a click becomes a handle drag
  const FADE_MS = 600;

  type Anchor = { x: number; y: number; ix: number; iy: number; ox: number; oy: number };
  type Shape = {
    anchors: Anchor[];
    closed: boolean;
    g: SVGGElement;
    path: SVGPathElement;
    marks: SVGGElement;
  };

  // The pen nib from PenToolPath.astro, tilted like a held pen, with its tip as the cursor hotspot.
  // The "close" variant adds a small ring, like Figma's close-path cursor.
  function nibCursor(close: boolean) {
    const svg =
      `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32">` +
      `<g transform="translate(4 30) rotate(30)">` +
      `<path d="M0 0 L-9 -22 L0 -32 L9 -22 Z" fill="${INK}" stroke="#fff" stroke-width="1.5" stroke-linejoin="round"/>` +
      `<circle cx="0" cy="-18" r="2.4" fill="#fff"/>` +
      `<line x1="0" y1="-18" x2="0" y2="-3" stroke="#fff" stroke-width="1.2"/>` +
      `</g>` +
      (close ? `<circle cx="25" cy="27" r="3.5" fill="#fff" stroke="${INK}" stroke-width="1.5"/>` : '') +
      `</svg>`;
    return `url("data:image/svg+xml,${encodeURIComponent(svg)}") 4 30, crosshair`;
  }

  function initPenMode() {
    const w = window as any;
    if (w.__penModeInit) return;
    w.__penModeInit = true;

    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const CURSOR_PEN = nibCursor(false);
    const CURSOR_CLOSE = nibCursor(true);

    if (finePointer.matches) {
      console.log('%cPsst: press P anywhere on this site to pick up the pen tool.', 'font-size: 12px; color: #4a5ee4;');
    }

    let active = false;
    let overlay: SVGSVGElement | null = null;
    let shapesG: SVGGElement | null = null;
    let preview: SVGPathElement | null = null;
    let shapes: Shape[] = [];
    let current: Shape | null = null;
    let drag: { shape: Shape; anchor: Anchor; sx: number; sy: number; moved: boolean; pointerId: number } | null = null;
    let pointer: { x: number; y: number } | null = null;
    let toastTimer = 0;

    const toast = () => document.getElementById('pen-mode-toast');

    const isEditable = (el: EventTarget | null) => {
      if (!(el instanceof Element)) return false;
      if ((el as HTMLElement).isContentEditable) return true;
      return !!el.closest('input, textarea, select, [contenteditable]:not([contenteditable="false"])');
    };

    const el = <K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string | number> = {}) => {
      const node = document.createElementNS(SVG_NS, tag);
      for (const k in attrs) node.setAttribute(k, String(attrs[k]));
      return node;
    };

    const nearFirst = (x: number, y: number) => {
      if (!current || current.anchors.length < 2) return false;
      const a = current.anchors[0];
      return Math.hypot(x - a.x, y - a.y) <= CLOSE_RADIUS;
    };

    // ---- Rendering ----------------------------------------------------------------------------

    function pathData(anchors: Anchor[], closed: boolean) {
      if (!anchors.length) return '';
      const a0 = anchors[0];
      let d = `M${a0.x} ${a0.y}`;
      for (let i = 1; i < anchors.length; i++) {
        const p = anchors[i - 1], a = anchors[i];
        d += ` C${p.ox} ${p.oy} ${a.ix} ${a.iy} ${a.x} ${a.y}`;
      }
      if (closed && anchors.length > 1) {
        const last = anchors[anchors.length - 1];
        d += ` C${last.ox} ${last.oy} ${a0.ix} ${a0.iy} ${a0.x} ${a0.y} Z`;
      }
      return d;
    }

    function render(shape: Shape, highlightFirst = false) {
      shape.path.setAttribute('d', pathData(shape.anchors, shape.closed));
      shape.path.classList.toggle('pm-closed', shape.closed);

      const editing = shape === current || (drag && drag.shape === shape);
      shape.marks.replaceChildren();
      // Handles only on the shape being drawn, so finished shapes read cleanly
      if (editing) {
        for (const a of shape.anchors) {
          if (a.ox === a.x && a.oy === a.y) continue;
          shape.marks.appendChild(el('line', { x1: a.ix, y1: a.iy, x2: a.ox, y2: a.oy, stroke: INK, 'stroke-width': 1 }));
          shape.marks.appendChild(el('circle', { cx: a.ix, cy: a.iy, r: 4, fill: INK }));
          shape.marks.appendChild(el('circle', { cx: a.ox, cy: a.oy, r: 4, fill: INK }));
        }
      }
      shape.anchors.forEach((a, i) => {
        shape.marks.appendChild(
          el('rect', {
            x: a.x - 6, y: a.y - 6, width: 12, height: 12,
            fill: highlightFirst && i === 0 ? INK : '#fff',
            stroke: INK, 'stroke-width': 2,
          })
        );
      });
    }

    function renderPreview() {
      if (!preview || !overlay) return;
      const closing = !!pointer && !drag && nearFirst(pointer.x, pointer.y);
      overlay.style.cursor = closing ? CURSOR_CLOSE : CURSOR_PEN;
      if (current) render(current, closing);

      if (!current || !pointer || drag || !current.anchors.length) {
        preview.setAttribute('d', '');
        return;
      }
      const last = current.anchors[current.anchors.length - 1];
      if (closing) {
        const a0 = current.anchors[0];
        preview.setAttribute('d', `M${last.x} ${last.y} C${last.ox} ${last.oy} ${a0.ix} ${a0.iy} ${a0.x} ${a0.y}`);
      } else {
        preview.setAttribute('d', `M${last.x} ${last.y} C${last.ox} ${last.oy} ${pointer.x} ${pointer.y} ${pointer.x} ${pointer.y}`);
      }
    }

    // ---- Shapes -------------------------------------------------------------------------------

    function newShape(): Shape {
      const g = el('g');
      const path = el('path', { class: 'pm-shape-path' });
      const marks = el('g');
      g.append(path, marks);
      shapesG!.appendChild(g);
      const shape: Shape = { anchors: [], closed: false, g, path, marks };
      shapes.push(shape);
      return shape;
    }

    function closeCurrent() {
      if (!current || current.anchors.length < 2) return null;
      const shape = current;
      shape.closed = true;
      current = null;
      render(shape);
      renderPreview();
      return shape;
    }

    // ---- Pointer handlers (attached to the overlay, so they go away with it) ------------------

    function onPointerDown(e: PointerEvent) {
      if (e.button !== 0 || !overlay) return;
      e.preventDefault();
      try { overlay.setPointerCapture(e.pointerId); } catch {}
      const x = e.clientX, y = e.clientY;
      pointer = { x, y };

      if (nearFirst(x, y)) {
        // Close the path; dragging from here reshapes the first anchor's handles
        const first = current!.anchors[0];
        const shape = current!;
        drag = { shape, anchor: first, sx: x, sy: y, moved: false, pointerId: e.pointerId };
        closeCurrent();
        return;
      }

      if (!current) current = newShape();
      const a: Anchor = { x, y, ix: x, iy: y, ox: x, oy: y };
      current.anchors.push(a);
      drag = { shape: current, anchor: a, sx: x, sy: y, moved: false, pointerId: e.pointerId };
      render(current);
      renderPreview();
    }

    function onPointerMove(e: PointerEvent) {
      const x = e.clientX, y = e.clientY;
      pointer = { x, y };
      if (drag) {
        if (!drag.moved && Math.hypot(x - drag.sx, y - drag.sy) < DRAG_THRESHOLD) return;
        drag.moved = true;
        const a = drag.anchor;
        // Symmetric handles: out follows the pointer, in mirrors it
        a.ox = x; a.oy = y;
        a.ix = 2 * a.x - x; a.iy = 2 * a.y - y;
        render(drag.shape);
        return;
      }
      renderPreview();
    }

    function endDrag(e?: PointerEvent) {
      if (!drag) return;
      if (e && overlay) {
        try { overlay.releasePointerCapture(drag.pointerId); } catch {}
      }
      const shape = drag.shape;
      drag = null;
      render(shape);
      renderPreview();
    }

    function onPointerLeave() {
      if (drag) return;
      pointer = null;
      renderPreview();
    }

    const onBlur = () => endDrag();

    // Keep clicks on the canvas from reaching page-level click listeners (menus, analytics, etc.)
    const CLICK_TYPES = ['click', 'dblclick', 'auxclick'];
    function swallowClick(e: Event) {
      if (overlay && e.target instanceof Node && overlay.contains(e.target)) {
        e.preventDefault();
        e.stopImmediatePropagation();
      }
    }

    // ---- Enter / exit -------------------------------------------------------------------------

    function showToast() {
      const t = toast();
      if (!t) return;
      window.clearTimeout(toastTimer);
      t.innerHTML =
        '<span class="pm-title">Pen tool <kbd>P</kbd></span>' +
        '<span class="pm-sep" aria-hidden="true">&middot;</span>' +
        '<span>Click to add points, drag to curve</span>' +
        '<span class="pm-sep" aria-hidden="true">&middot;</span>' +
        '<span><kbd>Esc</kbd> to exit</span>';
      t.classList.add('pm-visible');
    }

    function hideToast() {
      const t = toast();
      if (!t) return;
      t.classList.remove('pm-visible');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => { if (!active) t.textContent = ''; }, reducedMotion.matches ? 0 : 250);
    }

    function enter() {
      if (active) return;
      active = true;
      shapes = [];
      current = null;
      drag = null;
      pointer = null;

      overlay = el('svg', { class: 'pm-overlay', 'aria-hidden': 'true', focusable: 'false' }) as SVGSVGElement;
      preview = el('path', { class: 'pm-preview' });
      shapesG = el('g');
      overlay.append(preview, shapesG);
      overlay.style.cursor = CURSOR_PEN;
      overlay.addEventListener('pointerdown', onPointerDown);
      overlay.addEventListener('pointermove', onPointerMove);
      overlay.addEventListener('pointerup', endDrag);
      overlay.addEventListener('pointercancel', endDrag);
      overlay.addEventListener('lostpointercapture', () => endDrag());
      overlay.addEventListener('pointerleave', onPointerLeave);
      overlay.addEventListener('contextmenu', (e) => e.preventDefault());
      document.body.appendChild(overlay);
      window.addEventListener('blur', onBlur);
      CLICK_TYPES.forEach((t) => window.addEventListener(t, swallowClick, true));

      document.documentElement.classList.add('pm-active');
      showToast();
      window.dispatchEvent(new CustomEvent('pen-mode:change', { detail: { active: true } }));
    }

    function exit() {
      if (!active) return;
      active = false;
      window.removeEventListener('blur', onBlur);
      CLICK_TYPES.forEach((t) => window.removeEventListener(t, swallowClick, true));
      document.documentElement.classList.remove('pm-active');
      hideToast();
      window.dispatchEvent(new CustomEvent('pen-mode:change', { detail: { active: false } }));

      const leaving = overlay;
      overlay = null;
      shapesG = null;
      preview = null;
      shapes = [];
      current = null;
      drag = null;
      pointer = null;
      if (!leaving) return;

      // Clicks go straight back to the page; the drawing fades out, then the overlay is removed
      leaving.classList.add('pm-leaving');
      leaving.style.cursor = '';
      if (reducedMotion.matches) {
        leaving.remove();
        return;
      }
      leaving.style.transition = `opacity ${FADE_MS}ms ease`;
      requestAnimationFrame(() => { leaving.style.opacity = '0'; });
      window.setTimeout(() => leaving.remove(), FADE_MS + 50);
    }

    // ---- The one permanent listener: the P toggle (plus Esc / Enter while active) -------------

    window.addEventListener(
      'keydown',
      (e) => {
        if (active && e.key === 'Escape') {
          exit();
          return;
        }
        if (active && e.key === 'Enter' && current && current.anchors.length >= 2 && !isEditable(e.target)) {
          e.preventDefault();
          closeCurrent();
          return;
        }
        if (e.key !== 'p' && e.key !== 'P') return;
        if (e.ctrlKey || e.metaKey || e.altKey || e.repeat || e.isComposing) return;
        if (isEditable(e.target) || isEditable(document.activeElement)) return;
        if (!active && !finePointer.matches) return;
        e.preventDefault();
        if (active) exit();
        else enter();
      },
      true
    );

    // The toolbar's pen button (PenToolButton) toggles pen mode too
    window.addEventListener('pen-mode:toggle', () => {
      if (active) exit();
      else if (finePointer.matches) enter();
    });

    document.addEventListener('astro:before-swap', exit);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPenMode);
  } else {
    initPenMode();
  }
</script>
