---
/**
 * MotionToggle - "Pause animations" control (WCAG 2.2.2 Pause, Stop, Hide).
 *
 * Moving content on the site (marquees, looping demo videos, rotating words, greetings, the
 * loader) starts automatically, so visitors need a way to stop it. Pressing this stores the
 * choice and reloads; an inline script in BaseLayout then makes every component see
 * `prefers-reduced-motion: reduce`, and a global CSS rule settles any remaining animations.
 * It also reflects the device's own reduced-motion setting.
 */
---

<button class="motion-toggle" id="motion-toggle" type="button" aria-pressed="false" aria-label="Pause animations">
  <svg class="motion-icon motion-icon-pause" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
    <rect x="6" y="5" width="4" height="14" rx="1" />
    <rect x="14" y="5" width="4" height="14" rx="1" />
  </svg>
  <svg class="motion-icon motion-icon-play" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M8 5.5v13a1 1 0 0 0 1.5.87l10.4-6.5a1 1 0 0 0 0-1.74L9.5 4.63A1 1 0 0 0 8 5.5z" />
  </svg>
  <span class="motion-tip" aria-hidden="true">Pause animations</span>
</button>

<style>
  .motion-toggle {
    position: fixed;
    left: 2rem;
    bottom: 2rem;
    z-index: 100;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(12, 12, 12, 0.85);
    color: #F5F5F0;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  @media (max-width: 767px) {
    .motion-toggle { left: 1rem; bottom: 1rem; width: 44px; height: 44px; }
  }

  .motion-icon { fill: currentColor; }
  .motion-icon-play { display: none; }
  .motion-toggle[aria-pressed='true'] .motion-icon-pause { display: none; }
  .motion-toggle[aria-pressed='true'] .motion-icon-play { display: block; }

  .motion-toggle:focus-visible {
    outline: 2px solid #7b8af2;
    outline-offset: 3px;
  }

  /* Visible label on hover and keyboard focus */
  .motion-tip {
    position: absolute;
    left: calc(100% + 10px);
    white-space: nowrap;
    padding: 6px 10px;
    border-radius: 999px;
    background: #0C0C0C;
    color: #F5F5F0;
    font: 500 12px/1 'Space Grotesk', sans-serif;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .motion-toggle:hover .motion-tip,
  .motion-toggle:focus-visible .motion-tip { opacity: 1; }
</style>

<script>
  const btn = document.getElementById('motion-toggle');
  if (btn && !btn.dataset.init) {
    btn.dataset.init = 'true';
    const tip = btn.querySelector('.motion-tip');
    // Reduced either by this toggle or by the device setting (BaseLayout patches matchMedia for the toggle)
    const reduced = document.documentElement.classList.contains('reduce-motion') ||
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const label = reduced ? 'Play animations' : 'Pause animations';
    // Constant accessible name; the pressed state says whether animations are paused
    btn.setAttribute('aria-pressed', String(reduced));
    if (tip) tip.textContent = label;

    btn.addEventListener('click', () => {
      try {
        if (reduced) localStorage.setItem('motion', 'playing');
        else localStorage.setItem('motion', 'paused');
      } catch { /* storage unavailable */ }
      window.location.reload();
    });
  }
</script>
