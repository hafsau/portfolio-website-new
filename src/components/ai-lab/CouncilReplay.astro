---
/**
 * Replays a real AI council: the question, three reviewers who disagreed, and the call Hafsa made.
 * A pen line (the site's pen-tool stroke) draws from the advice she took, past the warning she
 * acted on, to her decision as the section scrolls. Without JS or with reduced motion it is a
 * plain ordered list with the line fully drawn.
 */
import CodeTerminal from '../CodeTerminal.astro';
import { councilReplay as c } from '../../data/aiLab';
---

<div class="cr full-width" data-council>
  <svg class="cr-line" aria-hidden="true"><path class="cr-path" d="" /><path class="cr-path" d="" /></svg>

  <ol class="cr-steps">
    <li class="cr-step">
      <p class="cr-kicker">The question · {c.date}</p>
      <p class="cr-question">{c.question}</p>
      <div class="cr-terminal">
        <CodeTerminal prompts={[c.prompt]} />
      </div>
    </li>

    <li class="cr-step">
      <p class="cr-kicker">Three reviewers, three answers</p>
      <div class="cr-lenses">
        {c.lenses.map((l, i) => (
          <section class="cr-lens" aria-label={l.role}>
            <h3 class="cr-role">{l.role}</h3>
            <p class="cr-pick" data-anchor={i === 0 ? 'start' : undefined}>{l.pick}</p>
            <p class="cr-said" data-anchor={i === 2 ? 'via' : undefined}>“{l.said}”</p>
            <p class="cr-reason">{l.reason}</p>
          </section>
        ))}
      </div>
    </li>

    <li class="cr-step cr-call">
      <p class="cr-kicker">My call</p>
      <p class="cr-choice" data-anchor="end">{c.decision.choice}</p>
      <p class="cr-because">{c.decision.because}</p>
      <p class="cr-overruled">
        <span class="cr-overruled-label">Overruled</span>
        <del>{c.decision.overruled.suggestion}</del>
        <span class="cr-overruled-note">{c.decision.overruled.note}</span>
      </p>
    </li>
  </ol>
</div>

<style>
  .cr {
    position: relative;
    margin-top: 2.5rem;
  }

  .cr-line {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .cr-path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  :global(.cr-anchor) {
    fill: var(--color-bg);
    stroke: var(--color-accent);
    stroke-width: 1.5;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  :global(.cr-anchor.is-on) { opacity: 1; }

  .cr-steps {
    position: relative;
    margin: 0;
    padding: 0 0 0 28px;
    list-style: none;
  }

  @media (min-width: 900px) {
    .cr-steps { padding-left: 0; }
  }

  .cr-step + .cr-step { margin-top: clamp(3rem, 7vw, 5rem); }

  :global(.case-content) .cr-kicker {
    margin: 0 0 0.75rem;
    font: 500 12px/1.4 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  :global(.case-content) .cr-question {
    max-width: 34ch;
    margin: 0 0 1.75rem;
    font-size: clamp(1.375rem, 2.6vw, 1.875rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-fg);
    text-wrap: balance;
  }

  .cr-terminal :global(.code-terminal) { margin: 0; }

  .cr-lenses {
    display: grid;
    gap: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-fg) 14%, transparent);
  }

  @media (min-width: 900px) {
    .cr-lenses { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .cr-lens {
    padding: 1.5rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-fg) 14%, transparent);
  }

  @media (min-width: 900px) {
    .cr-lens {
      padding: 1.5rem 1.75rem 0;
      border-bottom: 0;
    }
    .cr-lens:first-child { padding-left: 0; }
    .cr-lens + .cr-lens { border-left: 1px solid color-mix(in srgb, var(--color-fg) 14%, transparent); }
  }

  :global(.case-content) .cr-role {
    margin: 0 0 0.75rem;
    font: 500 12px/1.4 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  :global(.case-content) .cr-pick {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.15;
    color: var(--color-fg);
  }

  :global(.case-content) .cr-said {
    margin: 0 0 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--color-fg);
  }

  :global(.case-content) .cr-reason {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  :global(.case-content) .cr-choice {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-fg);
  }

  :global(.case-content) .cr-because {
    max-width: 52ch;
    font-size: 1.125rem;
    color: var(--color-fg);
  }

  :global(.case-content) .cr-overruled {
    display: grid;
    gap: 0.35rem;
    max-width: 52ch;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-fg) 14%, transparent);
  }

  .cr-overruled-label {
    font: 500 12px/1.4 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cr-overruled del {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-fg);
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-accent);
  }

  .cr-overruled-note { color: var(--color-muted); }
</style>

<script>
  function initCouncil() {
    document.querySelectorAll<HTMLElement>('[data-council]').forEach((root) => {
      if (root.dataset.init) return;
      root.dataset.init = 'true';
      const svg = root.querySelector<SVGSVGElement>('.cr-line')!;
      const [rail, branch] = Array.from(root.querySelectorAll<SVGPathElement>('.cr-path'));
      const ids = ['start', 'via', 'end'];
      const still = window.matchMedia('(prefers-reduced-motion: reduce)');
      const wide = window.matchMedia('(min-width: 900px)');
      type Pt = { x: number; y: number };
      // Each stroke draws as its span [from, to] (y within the root) scrolls past the reading line
      let strokes: { el: SVGPathElement; len: number; from: number; to: number }[] = [];
      let anchors: { el: SVGRectElement; y: number }[] = [];

      // Polyline with rounded corners, like a pen path with smooth anchor points
      const rounded = (p: Pt[], r = 14) => {
        let d = `M ${p[0].x} ${p[0].y}`;
        for (let i = 1; i < p.length - 1; i++) {
          const [a, b, c] = [p[i - 1], p[i], p[i + 1]];
          const k = Math.min(r, Math.hypot(b.x - a.x, b.y - a.y) / 2, Math.hypot(c.x - b.x, c.y - b.y) / 2);
          const ux = Math.sign(b.x - a.x), uy = Math.sign(b.y - a.y);
          const vx = Math.sign(c.x - b.x), vy = Math.sign(c.y - b.y);
          d += ` L ${b.x - ux * k} ${b.y - uy * k} Q ${b.x} ${b.y} ${b.x + vx * k} ${b.y + vy * k}`;
        }
        const last = p[p.length - 1];
        return `${d} L ${last.x} ${last.y}`;
      };

      // Two inputs, one decision: a rail runs from the advice she took down to her call, and a
      // branch from the engineer's warning joins it below the reviewers. Both stay in the gaps
      // between columns, so the line never crosses text and passes the art director's idea by.
      const layout = () => {
        const box = root.getBoundingClientRect();
        const rel = (el: Element) => {
          const r = el.getBoundingClientRect();
          return { left: r.left - box.left, bottom: r.bottom - box.top, mid: r.top - box.top + Math.min(r.height / 2, 16) };
        };
        const [start, via, end] = ids.map((id) => rel(root.querySelector(`[data-anchor="${id}"]`)!));
        const x = wide.matches ? rel(root.querySelector('.cr-lenses')!).left - 16 : 10;
        const a = { x, y: start.mid };
        const c = { x, y: end.mid };
        rail.setAttribute('d', rounded([a, c]));
        strokes = [{ el: rail, len: 0, from: a.y, to: c.y }];
        let b: Pt = { x, y: via.mid };
        if (wide.matches) {
          const gutter = rel(root.querySelectorAll('.cr-lens')[2]).left;
          const below = rel(root.querySelector('.cr-lenses')!).bottom + 28;
          b = { x: gutter, y: via.mid };
          branch.setAttribute('d', rounded([b, { x: gutter, y: below }, { x, y: below }]));
          strokes.push({ el: branch, len: 0, from: b.y, to: below });
        } else {
          branch.setAttribute('d', '');
        }
        strokes.forEach((s) => {
          s.len = s.el.getTotalLength();
          s.el.style.strokeDasharray = `${s.len}`;
        });
        svg.querySelectorAll('.cr-anchor').forEach((n) => n.remove());
        anchors = [a, b, c].map((p) => {
          const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
          rect.setAttribute('class', 'cr-anchor');
          rect.setAttribute('x', String(p.x - 4.5));
          rect.setAttribute('y', String(p.y - 4.5));
          rect.setAttribute('width', '9');
          rect.setAttribute('height', '9');
          svg.appendChild(rect);
          return { el: rect, y: p.y };
        });
        draw();
      };

      // Scroll-linked: a point is drawn once it passes 70% of the viewport height
      const draw = () => {
        const line = still.matches ? Infinity : innerHeight * 0.7 - root.getBoundingClientRect().top;
        strokes.forEach((s) => {
          const p = Math.min(1, Math.max(0, (line - s.from) / Math.max(1, s.to - s.from)));
          s.el.style.strokeDashoffset = `${s.len * (1 - p)}`;
        });
        anchors.forEach((a) => a.el.classList.toggle('is-on', line >= a.y));
      };

      let frame = 0;
      const onScroll = () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(draw); };
      addEventListener('scroll', onScroll, { passive: true });
      new ResizeObserver(layout).observe(root);
      document.fonts?.ready.then(layout);
      layout();
    });
  }
  initCouncil();
  document.addEventListener('astro:after-swap', initCouncil);
</script>
