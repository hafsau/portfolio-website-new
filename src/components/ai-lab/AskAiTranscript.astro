---
/**
 * Real exchanges with the site's assistant, typeset as a transcript with numbered margin notes
 * on the design decisions behind each answer. A "Try it" link opens the live assistant.
 */
import { askAiExchange as x } from '../../data/aiLab';

let n = 0;
const turns = x.turns.map((t) => ({
  ...t,
  noteN: ++n,
  followN: t.followUps ? ++n : undefined,
}));
---

<div class="tx" role="list" aria-label="Two real conversations with the assistant">
  {turns.map((t) => (
    <div class="tx-turn" role="listitem">
      <div class="tx-row">
        <span class="tx-who">You</span>
        <p class="tx-q">{t.question}</p>
      </div>
      <div class="tx-row">
        <span class="tx-who">Assistant</span>
        <div class="tx-a">
          <p>{t.answer}<sup class="tx-ref" aria-hidden="true">{t.noteN}</sup>{t.link && <> <a href={t.link.href}>{t.link.label}</a></>}</p>
          {t.followUps && (
            <p class="tx-follow">
              <span class="tx-follow-label">Suggested next<sup class="tx-ref" aria-hidden="true">{t.followN}</sup></span>
              {t.followUps.map((f) => <span class="tx-follow-q">{f}</span>)}
            </p>
          )}
        </div>
        <ol class="tx-notes" start={t.noteN}>
          <li><span class="tx-note-n" aria-hidden="true">{t.noteN}</span>{t.note}</li>
          {t.followUpNote && <li><span class="tx-note-n" aria-hidden="true">{t.followN}</span>{t.followUpNote}</li>}
        </ol>
      </div>
    </div>
  ))}
</div>

<style>
  .tx-turn + .tx-turn {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-fg) 10%, transparent);
  }

  .tx-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem 1.5rem;
    padding: 0.75rem 0;
  }

  @media (min-width: 720px) {
    .tx-row { grid-template-columns: 6rem minmax(0, 1fr); }
    .tx-notes { grid-column: 2; }
  }

  @media (min-width: 1000px) {
    .tx-row { grid-template-columns: 6rem minmax(0, 1fr) 13rem; }
    .tx-notes { grid-column: 3; }
  }

  .tx-who {
    padding-top: 0.2rem;
    font: 500 12px/1.5 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  :global(.case-content) .tx-q {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--color-fg);
  }

  :global(.case-content) .tx-a p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-fg);
  }

  :global(.case-content) .tx-a a {
    color: var(--color-fg);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.2em;
  }

  .tx-ref {
    margin-left: 0.15em;
    font: 500 0.7em/1 var(--font-mono);
    color: var(--color-accent-text);
  }

  :global(.case-content) .tx-a .tx-follow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .tx-follow-label {
    flex-basis: 100%;
    font: 500 11px/1.4 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .tx-follow-q::before {
    content: '\2192\00a0';
    color: var(--color-accent-text);
  }

  .tx-notes {
    display: grid;
    gap: 0.75rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1000px) {
    .tx-notes { margin-top: 0; }
  }

  :global(.case-content) .tx-notes li {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    margin: 0;
    font: 400 12.5px/1.55 var(--font-mono);
    color: var(--color-muted);
  }

  .tx-note-n { color: var(--color-accent-text); }
</style>
