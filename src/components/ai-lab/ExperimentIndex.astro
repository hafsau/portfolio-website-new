---
/**
 * Earlier AI experiments as a ruled index: name, tool, what it does, award, and a link whose
 * label follows from where it goes. On desktop a thumbnail follows the pointer over a row.
 */
import { labProjects, linkLabel } from '../../data/aiLab';
---

<div class="xi full-width" data-xi>
  <ul class="xi-list">
    {labProjects.map((p) => {
      const external = p.url.startsWith('http');
      return (
        <li class="xi-row" data-img={p.image}>
          <a class="xi-link" href={p.url} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
            <span class="xi-name">
              <span class="xi-title">{p.title}</span>
              <span class="xi-tool">{p.tool}</span>
            </span>
            <span class="xi-summary">
              {p.summary}
              {p.award && <span class="xi-award">{p.award}</span>}
            </span>
            <span class="xi-go">
              {linkLabel[p.status]}
              {external && <span class="sr-only"> (opens in a new tab)</span>}
              <span aria-hidden="true">{external ? ' ↗' : ' →'}</span>
            </span>
          </a>
        </li>
      );
    })}
  </ul>
  <img class="xi-peek" alt="" aria-hidden="true" decoding="async" />
</div>

<style>
  .xi { margin-top: 2rem; }

  :global(.case-content) .xi-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-fg) 14%, transparent);
  }

  :global(.case-content) .xi-row {
    margin: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-fg) 14%, transparent);
  }

  .xi-link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem 2rem;
    padding: 1.5rem 0;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  @media (min-width: 720px) {
    .xi-link {
      grid-template-columns: 14rem minmax(0, 1fr) 8rem;
      align-items: baseline;
    }
  }

  .xi-link:hover,
  .xi-link:focus-visible {
    background: color-mix(in srgb, var(--color-fg) 4%, transparent);
  }

  .xi-name {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .xi-title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.2;
    color: var(--color-fg);
  }

  .xi-tool {
    font: 500 12px/1.5 var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .xi-summary {
    grid-column: 1 / -1;
    max-width: 60ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  @media (min-width: 720px) {
    .xi-summary { grid-column: auto; }
  }

  .xi-award {
    display: block;
    margin-top: 0.35rem;
    color: var(--color-fg);
  }

  .xi-go {
    grid-row: 1;
    grid-column: 2;
    font: 500 12px/1.5 var(--font-mono);
    letter-spacing: 0.06em;
    white-space: nowrap;
    text-align: right;
    color: var(--color-accent-text);
  }

  @media (min-width: 720px) {
    .xi-go { grid-row: auto; grid-column: auto; }
  }

  .xi-link:hover .xi-go,
  .xi-link:focus-visible .xi-go {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .xi-peek {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 20;
    width: 240px;
    height: auto;
    margin: 0;
    border-radius: 8px;
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.35);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .xi-peek.is-on { opacity: 1; }

  @media (hover: none), (max-width: 899px) {
    .xi-peek { display: none; }
  }
</style>

<script>
  function initIndex() {
    document.querySelectorAll<HTMLElement>('[data-xi]').forEach((root) => {
      if (root.dataset.init) return;
      root.dataset.init = 'true';
      const peek = root.querySelector<HTMLImageElement>('.xi-peek')!;
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      root.querySelectorAll<HTMLElement>('.xi-row').forEach((row) => {
        row.addEventListener('pointerenter', () => {
          peek.src = row.dataset.img!;
          peek.classList.add('is-on');
        });
        row.addEventListener('pointerleave', () => peek.classList.remove('is-on'));
        row.addEventListener('pointermove', (e) => {
          // With reduced motion the preview sits beside the row instead of trailing the pointer
          const x = still ? row.getBoundingClientRect().right - 260 : e.clientX + 24;
          const y = still ? row.getBoundingClientRect().top : e.clientY - 80;
          peek.style.transform = `translate(${x}px, ${y}px)`;
        });
      });
    });
  }
  initIndex();
  document.addEventListener('astro:after-swap', initIndex);
</script>
