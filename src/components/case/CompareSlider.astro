---
/**
 * Before/after of one screen. A native range input drives the split, so it works with the
 * keyboard and screen readers; dragging the image moves the same input.
 */
interface Props {
  before: { src: string; alt: string };
  after: { src: string; alt: string };
  width: number;
  height: number;
  labels?: [string, string];
  /** Name of the thing being compared, for the slider's accessible label. */
  subject: string;
  start?: number;
}
const { before, after, width, height, labels = ['Before', 'After'], subject, start = 50 } = Astro.props;
---

<div class="cs" data-compare>
  <div class="cs-stage" style={`--split: ${start}%`}>
    <img class="cs-after" src={after.src} alt={after.alt} width={width} height={height} loading="lazy" decoding="async" />
    <img class="cs-before" src={before.src} alt={before.alt} width={width} height={height} loading="lazy" decoding="async" />
    <div class="cs-handle" aria-hidden="true"><span></span></div>
  </div>
  <label class="cs-range">
    <span>{labels[0]}</span>
    <input type="range" min="0" max="100" value={start} step="1" aria-label={`Compare ${subject}: ${labels[0].toLowerCase()} and ${labels[1].toLowerCase()}`} />
    <span>{labels[1]}</span>
  </label>
</div>

<style>
  .cs-stage {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    touch-action: pan-y;
    cursor: ew-resize;
    user-select: none;
  }

  :global(.case-content) .cs-stage img {
    display: block;
    width: 100%;
    height: auto;
    max-height: none;
    margin: 0;
    border-radius: 0;
    pointer-events: none;
  }

  :global(.case-content) .cs-stage .cs-before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--split)) 0 0);
  }

  .cs-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split);
    width: 2px;
    margin-left: -1px;
    background: var(--color-accent);
    pointer-events: none;
  }

  /* Pen-tool anchor: a small square on the line */
  .cs-handle span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 14px;
    border: 2px solid var(--color-accent);
    background: var(--color-bg);
    transform: translate(-50%, -50%);
  }

  .cs-range {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .cs-range input {
    flex: 1;
    min-height: 24px;
    accent-color: var(--color-accent);
  }
</style>

<script>
  function initCompare() {
    document.querySelectorAll<HTMLElement>('[data-compare]').forEach((root) => {
      if (root.dataset.init) return;
      root.dataset.init = 'true';
      const range = root.querySelector<HTMLInputElement>('input[type="range"]')!;
      const stage = root.querySelector<HTMLElement>('.cs-stage')!;
      const [a, b] = Array.from(root.querySelectorAll('.cs-range > span'), (s) => s.textContent ?? '');
      const apply = () => {
        const v = Number(range.value);
        stage.style.setProperty('--split', `${v}%`);
        range.setAttribute('aria-valuetext', v <= 3 ? b : v >= 97 ? a : `${v}% ${a.toLowerCase()}, ${100 - v}% ${b.toLowerCase()}`);
      };
      let dragging = false;
      const move = (e: PointerEvent) => {
        const r = stage.getBoundingClientRect();
        range.value = String(Math.round(Math.min(100, Math.max(0, ((e.clientX - r.left) / r.width) * 100))));
        apply();
      };
      range.addEventListener('input', apply);
      stage.addEventListener('pointerdown', (e) => { dragging = true; stage.setPointerCapture(e.pointerId); move(e); });
      stage.addEventListener('pointermove', (e) => { if (dragging) move(e); });
      stage.addEventListener('pointerup', () => { dragging = false; });
      stage.addEventListener('pointercancel', () => { dragging = false; });
      apply();
    });
  }
  initCompare();
  document.addEventListener('astro:after-swap', initCompare);
</script>
