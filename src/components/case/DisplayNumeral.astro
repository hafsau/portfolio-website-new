---
/**
 * One large figure with a plain-language line beside it. Use at most once per section,
 * and only for a real, sourced number.
 */
interface Props {
  value: string;
  label: string;
  note?: string;
}
const { value, label, note } = Astro.props;
---

<div class="dn">
  <span class="dn-value">{value}</span>
  <span class="dn-text">
    <span class="dn-label">{label}</span>
    {note && <span class="dn-note">{note}</span>}
  </span>
</div>

<style>
  .dn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    margin: 2rem 0 0;
  }

  .dn-value {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 11vw, 8rem);
    line-height: 0.85;
    letter-spacing: -0.03em;
    color: var(--color-fg);
    font-variant-numeric: tabular-nums;
  }

  .dn-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 22rem;
  }

  .dn-label {
    font-size: 1.125rem;
    line-height: 1.35;
    color: var(--color-fg);
  }

  .dn-note {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
</style>
