---
/**
 * The system in context: the Wix About page, each element labelled with the named style it uses.
 * Hover or focus a label to highlight the element. Boxes are measured from the live page (1440 x 604).
 */
const W = 1440, H = 604;
const parts = [
  { id: 'surface', n: 1, style: 'Cream surface', note: 'Header background, #FFF4DA', box: [0, 0, 1440, 88] },
  { id: 'menu', n: 2, style: 'Menu', note: "Wix's menu, set in Inter", box: [400, 22, 594, 42] },
  { id: 'donate', n: 3, style: 'Button · Secondary', note: 'Gold, 48px tall', box: [1212, 18, 158, 60] },
  { id: 'heading', n: 4, style: 'Heading 2', note: 'DM Serif Display', box: [44, 163, 673, 254] },
  { id: 'standfirst', n: 5, style: 'Paragraph 1', note: 'The standfirst, in Inter', box: [44, 431, 702, 104] },
];
const pct = (b: number[]) => `left:${(b[0] / W) * 100}%;top:${(b[1] / H) * 100}%;width:${(b[2] / W) * 100}%;height:${(b[3] / H) * 100}%`;
---

<figure class="pt-anat full-width" data-pt-anat>
  <div class="pt-anat-shot">
    <img src="/images/philly-truce/about-hero.webp" width="2000" height="839" loading="lazy" decoding="async"
      alt="The Philly Truce About page with five numbered labels: the cream header, the menu, the gold Donate button, the headline 'Two classmates. Thirty years. One promise.' and the standfirst below it, beside a portrait of the two founders." />
    {parts.map((p) => (
      <span class="pt-box" data-part={p.id} style={pct(p.box)} aria-hidden="true"><b>{p.n}</b></span>
    ))}
  </div>
  <ol class="pt-anat-legend">
    {parts.map((p) => (
      <li>
        <button type="button" class="pt-anat-item" data-part={p.id}>
          <span class="pt-anat-n" aria-hidden="true">{p.n}</span>
          <span class="pt-anat-style">{p.style}</span>
          <span class="pt-anat-note">{p.note}</span>
        </button>
      </li>
    ))}
  </ol>
  <figcaption class="pt-fig">Fig. 8 — The About page, labelled by style. Hover or focus a label to find it on the page.</figcaption>
</figure>

<style>
  .pt-anat { margin: 2.5rem 0 0; }

  .pt-anat-shot {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08);
  }

  :global(.case-content) .pt-anat-shot img {
    display: block;
    width: 100%;
    height: auto;
    max-height: none;
    margin: 0;
    border-radius: 0;
  }

  .pt-box {
    position: absolute;
    border: 1px solid rgb(0 39 104 / 0.55);
    border-radius: 6px;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .pt-box b {
    position: absolute;
    top: 6px;
    right: 6px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #002768;
    color: #FFF4DA;
    font: 700 12px/1 'PT Inter', system-ui, sans-serif;
    box-shadow: 0 0 0 2px #FFF4DA;
  }

  .pt-box[data-part='surface'] b { top: auto; bottom: 6px; right: auto; left: 150px; }
  .pt-box[data-part='menu'] b { top: 50%; right: -30px; transform: translateY(-50%); }
  .pt-box[data-part='donate'] b { top: 50%; right: auto; left: -30px; transform: translateY(-50%); }

  .pt-box.is-active { border: 2px solid #002768; background: rgb(0 39 104 / 0.08); }

  .pt-anat-legend {
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) { .pt-anat-legend { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .pt-anat-legend { grid-template-columns: repeat(3, 1fr); } }

  .pt-anat-legend li { margin: 0; }

  .pt-anat-item {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 2px 12px;
    align-items: center;
    width: 100%;
    padding: 10px 12px;
    border: 0;
    border-radius: 12px;
    background: #141414;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.07);
    text-align: left;
    color: var(--color-fg);
    cursor: pointer;
  }

  .pt-anat-item:hover, .pt-anat-item.is-active { box-shadow: inset 0 0 0 1px #FFF4DA; }

  .pt-anat-n {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #FFF4DA;
    color: #002768;
    font: 700 12px/1 'PT Inter', system-ui, sans-serif;
  }

  .pt-anat-style { font: 500 13px/1.3 'JetBrains Mono', monospace; color: #FFF4DA; }
  .pt-anat-note { font-size: 0.8125rem; color: var(--color-muted); }

  @media (max-width: 639px) {
    .pt-box b { width: 18px; height: 18px; font-size: 10px; }
    .pt-box[data-part='surface'] b { left: 80px; }
  }

  @media (prefers-reduced-motion: reduce) { .pt-box { transition: none; } }
</style>

<script>
  function initAnatomy() {
    document.querySelectorAll<HTMLElement>('[data-pt-anat]').forEach((root) => {
      if (root.dataset.init) return;
      root.dataset.init = 'true';
      const set = (id: string | null) => {
        root.querySelectorAll<HTMLElement>('[data-part]').forEach((el) => el.classList.toggle('is-active', el.dataset.part === id));
      };
      root.querySelectorAll<HTMLButtonElement>('.pt-anat-item').forEach((btn) => {
        btn.addEventListener('mouseenter', () => set(btn.dataset.part!));
        btn.addEventListener('focus', () => set(btn.dataset.part!));
        btn.addEventListener('click', () => set(btn.dataset.part!));
      });
      root.querySelector('.pt-anat-legend')!.addEventListener('mouseleave', () => {
        if (!root.contains(document.activeElement)) set(null);
      });
      root.addEventListener('focusout', (e) => {
        if (!root.contains((e as FocusEvent).relatedTarget as Node)) set(null);
      });
    });
  }
  initAnatomy();
  document.addEventListener('astro:after-swap', initAnatomy);
</script>
