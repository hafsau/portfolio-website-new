---
/** Self-hosted Philly Truce fonts, loaded only on the Philly Truce case study. */
---

<style is:global>
  @font-face {
    font-family: 'PT DM Serif Display';
    src: url('/fonts/philly-truce/dm-serif-display.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'PT DM Serif Display';
    src: url('/fonts/philly-truce/dm-serif-display-italic.woff2') format('woff2');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: 'PT Inter';
    src: url('/fonts/philly-truce/inter-var.woff2') format('woff2');
    font-weight: 400 600;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'PT Sacramento';
    src: url('/fonts/philly-truce/sacramento.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
</style>
