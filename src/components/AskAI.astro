---
/**
 * AskAI - "Ask Hafsa's AI" chat panel.
 *
 * Opened by any link to #ask-ai (or element with [data-ask-ai]). Sends the conversation to
 * /api/ask, which answers only from the site's own content. Accessible dialog: focus moves in
 * and is kept inside while open, Esc closes and returns focus, answers are announced politely.
 * Nothing is stored; the conversation lives only in this tab.
 */
const prompts = [
  'What has Hafsa shipped?',
  'Tell me about the Immunization project',
  'How does she use AI in her work?',
];
---

<div class="ask-ai-backdrop" id="ask-ai-backdrop" hidden></div>
<div
  class="ask-ai"
  id="ask-ai"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ask-ai-title"
  aria-describedby="ask-ai-note"
  hidden
>
  <header class="ask-ai-header">
    <h2 id="ask-ai-title">Ask Hafsa's AI</h2>
    <button type="button" class="ask-ai-close" id="ask-ai-close" aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
      </svg>
    </button>
  </header>

  <p class="ask-ai-note" id="ask-ai-note">
    Answers come only from this website and can be wrong. For anything important, email Hafsa.
    Chats aren't stored.
  </p>

  <div class="ask-ai-log" id="ask-ai-log" role="log" aria-live="polite" aria-relevant="additions" data-lenis-prevent>
    <div class="ask-ai-suggestions" id="ask-ai-suggestions">
      <p class="ask-ai-suggestions-label">Try asking</p>
      {prompts.map((p) => (
        <button type="button" class="ask-ai-suggestion" data-prompt={p}>{p}</button>
      ))}
    </div>
  </div>

  <form class="ask-ai-form" id="ask-ai-form">
    <label class="sr-only" for="ask-ai-input">Your question</label>
    <textarea
      id="ask-ai-input"
      class="ask-ai-input"
      rows="1"
      maxlength="800"
      placeholder="Ask about Hafsa's work"
      autocomplete="off"
    ></textarea>
    <button type="submit" class="ask-ai-send" id="ask-ai-send" aria-label="Send">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </form>
</div>

<style>
  .ask-ai-backdrop {
    position: fixed;
    inset: 0;
    z-index: 10040;
    background: rgba(0, 0, 0, 0.45);
  }

  .ask-ai {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 10050;
    width: min(440px, 100vw);
    display: flex;
    flex-direction: column;
    background: #0f0f12;
    color: #f5f5f0;
    border-left: 1px solid #26262d;
    box-shadow: -20px 0 60px rgba(0, 0, 0, 0.35);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    animation: ask-ai-in 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ask-ai[hidden], .ask-ai-backdrop[hidden] { display: none; }

  @keyframes ask-ai-in {
    from { transform: translateX(24px); opacity: 0; }
    to { transform: none; opacity: 1; }
  }

  .ask-ai-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.25rem 0.5rem;
  }

  .ask-ai-header h2 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .ask-ai-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid #2c2c33;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .ask-ai-note {
    margin: 0;
    padding: 0 1.25rem 1rem;
    font-size: 0.8rem;
    line-height: 1.5;
    color: #b8b8b8;
    border-bottom: 1px solid #222228;
  }

  .ask-ai-log {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .ask-ai-suggestions-label {
    margin: 0 0 0.5rem;
    font: 500 11px/1 'JetBrains Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #7b8af2;
  }

  .ask-ai-suggestion {
    display: block;
    width: 100%;
    margin-bottom: 0.5rem;
    padding: 0.75rem 0.9rem;
    text-align: left;
    font: inherit;
    font-size: 0.9rem;
    color: #f5f5f0;
    background: #17171c;
    border: 1px solid #2a2a32;
    border-radius: 12px;
    cursor: pointer;
  }

  .ask-ai-suggestion:hover { border-color: #4a5ee4; }

  .ask-ai :global(.ask-ai-msg) {
    max-width: 92%;
    padding: 0.75rem 0.95rem;
    border-radius: 14px;
    font-size: 0.925rem;
    line-height: 1.6;
    word-wrap: break-word;
  }

  .ask-ai :global(.ask-ai-msg-user) {
    align-self: flex-end;
    background: #4a5ee4;
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  .ask-ai :global(.ask-ai-msg-ai) {
    align-self: flex-start;
    background: #17171c;
    border: 1px solid #26262d;
    border-bottom-left-radius: 4px;
  }

  .ask-ai :global(.ask-ai-msg-ai a) { color: #8b9cff; text-decoration: underline; text-underline-offset: 2px; }
  .ask-ai :global(.ask-ai-msg-ai ul) { margin: 0.4rem 0 0; padding-left: 1.1rem; }
  .ask-ai :global(.ask-ai-msg-ai p) { margin: 0; }
  .ask-ai :global(.ask-ai-msg-ai p + p) { margin-top: 0.5rem; }
  .ask-ai :global(.ask-ai-msg-status) { color: #b8b8b8; font-style: italic; }

  .ask-ai-form {
    display: flex;
    gap: 0.5rem;
    align-items: flex-end;
    padding: 0.9rem 1.25rem 1.25rem;
    border-top: 1px solid #222228;
  }

  .ask-ai-input {
    flex: 1;
    min-height: 44px;
    max-height: 140px;
    resize: none;
    padding: 0.7rem 0.9rem;
    font: inherit;
    font-size: 0.95rem;
    color: #f5f5f0;
    background: #17171c;
    border: 1px solid #2c2c33;
    border-radius: 12px;
  }

  .ask-ai-input::placeholder { color: #8a8a93; }

  .ask-ai-send {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 0;
    background: #4a5ee4;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .ask-ai-send:disabled { opacity: 0.5; cursor: progress; }

  .ask-ai button:focus-visible,
  .ask-ai-input:focus-visible {
    outline: 2px solid #7b8af2;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ask-ai { animation: none; }
  }
</style>

<script>
  const CONTACT = 'hafsa.usmani2@gmail.com';
  const ERRORS: Record<string, string> = {
    not_configured: `The assistant isn't switched on yet. You can email Hafsa at ${CONTACT}.`,
    rate_limited: 'That was a lot of questions in a short time. Please try again in a few minutes.',
    default: `Something went wrong. Please try again, or email Hafsa at ${CONTACT}.`,
  };

  const panel = document.getElementById('ask-ai');
  const backdrop = document.getElementById('ask-ai-backdrop');
  const log = document.getElementById('ask-ai-log');
  const form = document.getElementById('ask-ai-form') as HTMLFormElement | null;
  const input = document.getElementById('ask-ai-input') as HTMLTextAreaElement | null;
  const send = document.getElementById('ask-ai-send') as HTMLButtonElement | null;
  const closeBtn = document.getElementById('ask-ai-close');
  const suggestions = document.getElementById('ask-ai-suggestions');

  if (panel && backdrop && log && form && input && send && closeBtn && !panel.dataset.init) {
    panel.dataset.init = 'true';
    const history: { role: 'user' | 'assistant'; content: string }[] = [];
    let opener: HTMLElement | null = null;
    let busy = false;

    const escapeHtml = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    // Minimal, safe formatting: paragraphs, "- " bullets, and markdown links to this site or email
    function format(text: string) {
      const linkify = (s: string) =>
        escapeHtml(s).replace(/\[([^\]]+)\]\(((?:\/[^\s)]*)|(?:mailto:[^\s)]+))\)/g, '<a href="$2">$1</a>');
      const blocks: string[] = [];
      let list: string[] = [];
      const flush = () => { if (list.length) { blocks.push(`<ul>${list.join('')}</ul>`); list = []; } };
      for (const line of text.split('\n')) {
        const bullet = line.match(/^\s*[-*]\s+(.*)/);
        if (bullet) { list.push(`<li>${linkify(bullet[1])}</li>`); continue; }
        flush();
        if (line.trim()) blocks.push(`<p>${linkify(line.trim())}</p>`);
      }
      flush();
      return blocks.join('');
    }

    function addMessage(role: 'user' | 'ai' | 'status', text: string) {
      const el = document.createElement('div');
      el.className = `ask-ai-msg ask-ai-msg-${role === 'status' ? 'ai ask-ai-msg-status' : role}`;
      if (role === 'ai') el.innerHTML = format(text);
      else el.textContent = text;
      log!.appendChild(el);
      log!.scrollTop = log!.scrollHeight;
      return el;
    }

    function focusables() {
      return Array.from(panel!.querySelectorAll<HTMLElement>('button:not([disabled]), textarea, a[href]'))
        .filter((el) => el.offsetParent !== null);
    }

    function open(trigger: HTMLElement | null) {
      opener = trigger;
      panel!.hidden = false;
      backdrop!.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      input!.focus();
    }

    function close() {
      panel!.hidden = true;
      backdrop!.hidden = true;
      document.documentElement.style.overflow = '';
      opener?.focus();
    }

    async function ask(question: string) {
      const q = question.trim();
      if (!q || busy) return;
      busy = true;
      send!.disabled = true;
      suggestions?.remove();
      addMessage('user', q);
      history.push({ role: 'user', content: q });
      const pending = addMessage('status', 'Thinking...');
      log!.setAttribute('aria-busy', 'true');

      try {
        const res = await fetch('/api/ask', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: history.slice(-12) }),
        });
        const data = await res.json().catch(() => ({}));
        pending.remove();
        if (res.ok && typeof data.answer === 'string') {
          addMessage('ai', data.answer);
          history.push({ role: 'assistant', content: data.answer });
        } else {
          history.pop(); // drop the unanswered question so the conversation stays valid
          addMessage('ai', ERRORS[data.error] ?? ERRORS.default);
        }
      } catch {
        pending.remove();
        history.pop();
        addMessage('ai', ERRORS.default);
      } finally {
        log!.removeAttribute('aria-busy');
        busy = false;
        send!.disabled = false;
        input!.focus();
      }
    }

    document.addEventListener('click', (e) => {
      const trigger = (e.target as Element).closest<HTMLElement>('a[href="#ask-ai"], [data-ask-ai]');
      if (!trigger) return;
      e.preventDefault(); // let the click still reach menus so they close behind the panel
      open(trigger);
    }, true);

    closeBtn.addEventListener('click', close);
    backdrop.addEventListener('click', close);

    panel.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { e.preventDefault(); close(); return; }
      if (e.key !== 'Tab') return;
      const items = focusables();
      if (!items.length) return;
      const first = items[0], last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });

    suggestions?.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('.ask-ai-suggestion');
      if (b?.dataset.prompt) ask(b.dataset.prompt);
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input!.value;
      input!.value = '';
      input!.style.height = '';
      ask(q);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
        e.preventDefault();
        form!.requestSubmit();
      }
    });

    input.addEventListener('input', () => {
      input!.style.height = 'auto';
      input!.style.height = Math.min(input!.scrollHeight, 140) + 'px';
    });
  }
</script>
