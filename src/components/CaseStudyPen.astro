---
/**
 * CaseStudyPen - carries the home page's pen tool into the case studies.
 *
 * - Desktop (1024px+): a bezier path in the left margin with one anchor point per section (h2).
 *   The path draws in as you read; the current section's anchor is "selected" (filled), and
 *   anchors are buttons that jump to their section. Labels show beside anchors on wide screens.
 * - Smaller screens: a compact "03 / 09 · Section" chip instead of the rail.
 * - Adds a "Read time" item to the project details.
 * - Signs off with the "Hafsa" signature (written on with the pen) before the next project.
 */
import { SIGNATURE_PATH, SIGNATURE_BOUNDS, SIGNATURE_FLOURISH } from '../lib/signature';
const sig = SIGNATURE_BOUNDS;
---

<nav class="cs-pen" id="cs-pen" aria-label="Case study sections">
  <svg class="cs-pen-svg" id="cs-pen-svg" aria-hidden="true">
    <path class="cs-pen-track" id="cs-pen-track" />
    <path class="cs-pen-line" id="cs-pen-line" />
    <g class="cs-pen-nib" id="cs-pen-nib">
      <path d="M0 0 L-9 -22 L0 -32 L9 -22 Z" />
      <circle cx="0" cy="-18" r="2.4" />
      <line x1="0" y1="-18" x2="0" y2="-3" />
    </g>
  </svg>
  <ol class="cs-pen-anchors" id="cs-pen-anchors"></ol>
</nav>

<div class="cs-pen-chip" id="cs-pen-chip" aria-hidden="true">
  <span class="cs-pen-chip-count" id="cs-pen-chip-count"></span>
  <span class="cs-pen-chip-label" id="cs-pen-chip-label"></span>
</div>

<template id="cs-pen-signoff-template">
  <div class="cs-signoff" aria-hidden="true">
    <span class="cs-signoff-note">Thanks for reading</span>
    <svg class="cs-signoff-svg" viewBox={`${sig.x - 40} ${sig.y - 60} ${sig.w + 120} ${sig.h + 120}`}>
      <defs>
        <clipPath id="cs-signoff-clip"><rect class="cs-signoff-reveal" x={sig.x - 20} y={sig.y - 60} width="0" height={sig.h + 120} /></clipPath>
      </defs>
      <path class="cs-signoff-name" clip-path="url(#cs-signoff-clip)" d={SIGNATURE_PATH} />
      <path class="cs-signoff-flourish" d={SIGNATURE_FLOURISH} />
    </svg>
  </div>
</template>

<style>
  .cs-pen {
    position: fixed;
    left: 40px;
    top: 18vh;
    height: 64vh;
    width: 260px;
    z-index: 40;
    pointer-events: none;
    display: none;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .cs-pen.is-visible { opacity: 1; }

  @media (min-width: 1024px) {
    .cs-pen { display: block; }
  }

  .cs-pen-svg {
    position: absolute;
    left: 0;
    top: 0;
    width: 40px;
    height: 100%;
    overflow: visible;
  }

  .cs-pen-track {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-dasharray: 2 6;
    stroke-linecap: round;
    opacity: 0.35;
  }

  .cs-pen-line {
    fill: none;
    stroke: #4A5EE4;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .cs-pen-nib path { fill: #4A5EE4; stroke: #fff; stroke-width: 1.5; stroke-linejoin: round; }
  .cs-pen-nib circle { fill: #fff; }
  .cs-pen-nib line { stroke: #fff; stroke-width: 1.2; }

  .cs-pen-anchors {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cs-pen-anchors :global(li) {
    position: absolute;
    left: 0;
    margin-top: -12px;
  }

  .cs-pen-anchors :global(button) {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 14px;
    height: 24px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    color: inherit;
    font: 500 11px/1 'JetBrains Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .cs-pen-anchors :global(.cs-anchor-square) {
    position: relative;
    flex: none;
    width: 10px;
    height: 10px;
    margin-left: 15px;
    background: var(--color-bg, #0C0C0C);
    border: 2px solid #4A5EE4;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  /* Bezier handles on the selected anchor */
  .cs-pen-anchors :global(.cs-anchor-square::before),
  .cs-pen-anchors :global(.cs-anchor-square::after) {
    content: '';
    position: absolute;
    left: 50%;
    width: 1px;
    height: 0;
    background: #4A5EE4;
    transition: height 0.25s ease, top 0.25s ease;
  }

  .cs-pen-anchors :global(.cs-anchor-square::before) { bottom: 100%; }
  .cs-pen-anchors :global(.cs-anchor-square::after) { top: 100%; }

  .cs-pen-anchors :global(.is-current .cs-anchor-square) { background: #4A5EE4; transform: scale(1.15); }
  .cs-pen-anchors :global(.is-current .cs-anchor-square::before),
  .cs-pen-anchors :global(.is-current .cs-anchor-square::after) { height: 14px; }

  .cs-pen-anchors :global(.cs-anchor-label) {
    max-width: 170px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #8a8a93;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
  }

  .cs-pen-anchors :global(.is-current .cs-anchor-label) { color: #4A5EE4; }

  /* Labels only where the margin is wide enough to stay clear of the text column */
  @media (min-width: 1280px) {
    .cs-pen-anchors :global(.is-current .cs-anchor-label),
    .cs-pen-anchors :global(button:hover .cs-anchor-label),
    .cs-pen-anchors :global(button:focus-visible .cs-anchor-label) { opacity: 1; transform: none; }
  }

  .cs-pen-anchors :global(button:hover .cs-anchor-square) { transform: scale(1.25); }

  .cs-pen-anchors :global(button:focus-visible) {
    outline: 2px solid #4A5EE4;
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* Small screens: progress chip */
  .cs-pen-chip {
    position: fixed;
    left: 16px;
    bottom: 18px;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: calc(100vw - 110px);
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(12, 12, 12, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #F5F5F0;
    font: 500 11px/1 'JetBrains Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }

  .cs-pen-chip.is-visible { opacity: 1; transform: none; }
  .cs-pen-chip-count { color: #8b9cff; flex: none; }
  .cs-pen-chip-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  @media (min-width: 1024px) {
    .cs-pen-chip { display: none; }
  }

  /* Sign-off */
  :global(.cs-signoff) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin: 0 auto 3rem;
  }

  :global(.cs-signoff-note) {
    font: 500 11px/1 'JetBrains Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-muted);
  }

  :global(.cs-signoff-svg) { width: min(200px, 60vw); height: auto; overflow: visible; }
  :global(.cs-signoff-name) { fill: #4A5EE4; }
  :global(.cs-signoff-flourish) { fill: none; stroke: #4A5EE4; stroke-width: 22; stroke-linecap: round; }

  @media (prefers-reduced-motion: reduce) {
    .cs-pen, .cs-pen-chip, .cs-pen-anchors :global(.cs-anchor-label), .cs-pen-anchors :global(.cs-anchor-square) { transition: none; }
  }
</style>

<script>
  import { getLenis } from '../scripts/gsap-utils';

  const SIG = { x: 11, y: -551, w: 2700, h: 908 };

  function initCaseStudyPen() {
    const rail = document.getElementById('cs-pen');
    const svg = document.getElementById('cs-pen-svg') as unknown as SVGSVGElement | null;
    const track = document.getElementById('cs-pen-track') as unknown as SVGPathElement | null;
    const line = document.getElementById('cs-pen-line') as unknown as SVGPathElement | null;
    const nib = document.getElementById('cs-pen-nib');
    const list = document.getElementById('cs-pen-anchors');
    const chip = document.getElementById('cs-pen-chip');
    const chipCount = document.getElementById('cs-pen-chip-count');
    const chipLabel = document.getElementById('cs-pen-chip-label');
    const content = document.querySelector<HTMLElement>('.case-content');
    if (!rail || !svg || !track || !line || !nib || !list || !chip || !chipCount || !chipLabel || !content) return;
    if (rail.dataset.init) return;
    rail.dataset.init = 'true';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const headings = Array.from(content.querySelectorAll<HTMLElement>('h2'));
    if (!headings.length) return;

    // Read time in the project details (about 230 words per minute)
    const words = (content.innerText || '').trim().split(/\s+/).length;
    const details = document.querySelector('.details-grid');
    const template = details?.querySelector<HTMLElement>('.detail-item');
    if (details && template && !details.querySelector('[data-read-time]')) {
      // Clone an existing item so it carries the layout's (scoped) styles
      const item = template.cloneNode(true) as HTMLElement;
      item.dataset.readTime = '';
      const label = item.querySelector('.detail-label');
      const value = item.querySelector('.detail-value');
      if (label) label.textContent = 'Read time';
      if (value) value.textContent = `${Math.max(1, Math.round(words / 230))} min`;
      details.appendChild(item);
    }

    // Anchor buttons
    list.replaceChildren();
    const items = headings.map((h, i) => {
      if (!h.id) h.id = 'section-' + (h.textContent || String(i)).toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      const li = document.createElement('li');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.setAttribute('aria-label', `Jump to ${h.textContent?.trim()}`);
      btn.innerHTML = `<span class="cs-anchor-square"></span><span class="cs-anchor-label">${h.textContent?.trim() ?? ''}</span>`;
      btn.addEventListener('click', () => {
        const top = h.getBoundingClientRect().top + window.scrollY - 110;
        const lenis = getLenis();
        if (lenis && !reduceMotion) lenis.scrollTo(top, { duration: 1.1 });
        else window.scrollTo({ top, behavior: reduceMotion ? 'auto' : 'smooth' });
        h.setAttribute('tabindex', '-1');
        h.focus({ preventScroll: true });
      });
      li.appendChild(btn);
      list.appendChild(li);
      return li;
    });

    let ys: number[] = [];
    let total = 0;
    let samples: { l: number; y: number }[] = [];
    let drawn = 0;

    function layout() {
      const h = rail!.clientHeight;
      svg!.setAttribute('height', String(h));
      // Spread anchors by where each section sits in the article, with a minimum gap so labels never collide
      const start = content!.getBoundingClientRect().top + window.scrollY;
      const end = start + content!.offsetHeight;
      const raw = headings.map((el) => (el.getBoundingClientRect().top + window.scrollY - start) / Math.max(1, end - start));
      const minGap = 26 / h;
      const pos: number[] = [];
      raw.forEach((r, i) => pos.push(Math.max(r, i ? pos[i - 1] + minGap : 0)));
      const scale = pos[pos.length - 1] > 1 ? 1 / pos[pos.length - 1] : 1;
      ys = pos.map((p) => p * scale * h);
      items.forEach((li, i) => { li.style.top = ys[i] + 'px'; });

      // A gentle S-curve between consecutive anchors, like a hand-placed pen path
      const x = 20;
      let d = `M ${x} ${ys[0]}`;
      for (let i = 1; i < ys.length; i++) {
        const a = ys[i - 1], b = ys[i], bow = (i % 2 ? 1 : -1) * Math.min(14, (b - a) * 0.35);
        d += ` C ${x + bow} ${a + (b - a) * 0.35}, ${x - bow} ${a + (b - a) * 0.65}, ${x} ${b}`;
      }
      track!.setAttribute('d', d);
      line!.setAttribute('d', d);
      total = line!.getTotalLength();
      samples = [];
      for (let l = 0; l <= total; l += 2) samples.push({ l, y: line!.getPointAtLength(l).y });
      samples.push({ l: total, y: ys[ys.length - 1] });
      line!.style.strokeDasharray = String(total);
    }

    function lengthAtY(y: number) {
      let lo = 0, hi = samples.length - 1;
      while (lo < hi) { const m = (lo + hi) >> 1; if (samples[m].y < y) lo = m + 1; else hi = m; }
      return samples[lo].l;
    }

    let current = -1;
    function frame() {
      requestAnimationFrame(frame);
      if (!ys.length) return;
      const marker = window.scrollY + window.innerHeight * 0.35;
      const tops = headings.map((el) => el.getBoundingClientRect().top + window.scrollY);
      let idx = -1;
      tops.forEach((t, i) => { if (t <= marker) idx = i; });

      // Visible only while reading the content
      const cStart = content!.getBoundingClientRect().top + window.scrollY;
      const cEnd = cStart + content!.offsetHeight;
      const reading = window.scrollY + window.innerHeight * 0.6 > cStart && window.scrollY + window.innerHeight * 0.4 < cEnd;
      rail!.classList.toggle('is-visible', reading);
      chip!.classList.toggle('is-visible', reading && idx >= 0);

      // Pen tip position between the current and next anchor
      let tipY = ys[0];
      if (idx >= 0) {
        const next = idx + 1 < tops.length ? tops[idx + 1] : cEnd;
        const f = Math.min(1, Math.max(0, (marker - tops[idx]) / Math.max(1, next - tops[idx])));
        const nextY = idx + 1 < ys.length ? ys[idx + 1] : ys[ys.length - 1];
        tipY = ys[idx] + (nextY - ys[idx]) * f;
      }
      const target = lengthAtY(tipY);
      drawn = reduceMotion ? target : drawn + (target - drawn) * 0.2;
      line!.style.strokeDashoffset = String(total - drawn);
      const p = line!.getPointAtLength(drawn), p2 = line!.getPointAtLength(Math.min(total, drawn + 2));
      const angle = (Math.atan2(p2.y - p.y, p2.x - p.x) * 180) / Math.PI + 90;
      nib!.setAttribute('transform', `translate(${p.x} ${p.y}) rotate(${angle}) scale(0.7)`);

      if (idx !== current) {
        current = idx;
        items.forEach((li, i) => li.classList.toggle('is-current', i === idx));
        items.forEach((li, i) => li.querySelector('button')?.setAttribute('aria-current', i === idx ? 'true' : 'false'));
        if (idx >= 0) {
          chipCount!.textContent = `${String(idx + 1).padStart(2, '0')} / ${String(headings.length).padStart(2, '0')}`;
          chipLabel!.textContent = headings[idx].textContent?.trim() ?? '';
        }
      }
    }

    // Sign-off: insert before the project navigation and write it on when it scrolls into view
    const tpl = document.getElementById('cs-pen-signoff-template') as HTMLTemplateElement | null;
    const navSection = document.querySelector('.project-nav-section .container');
    if (tpl && navSection && !navSection.querySelector('.cs-signoff')) {
      navSection.prepend(tpl.content.cloneNode(true));
      const reveal = navSection.querySelector<SVGRectElement>('.cs-signoff-reveal');
      const flourish = navSection.querySelector<SVGPathElement>('.cs-signoff-flourish');
      if (reveal && flourish) {
        const fl = flourish.getTotalLength();
        flourish.style.strokeDasharray = String(fl);
        flourish.style.strokeDashoffset = String(fl);
        const write = () => {
          const t0 = performance.now();
          const step = (now: number) => {
            const t = reduceMotion ? 1 : Math.min(1, (now - t0) / 1700);
            const e = 1 - Math.pow(1 - t, 2);
            reveal.setAttribute('width', String((SIG.w + 40) * Math.min(1, e / 0.8)));
            flourish.style.strokeDashoffset = String(fl * (1 - Math.max(0, (e - 0.8) / 0.2)));
            if (t < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        };
        new IntersectionObserver((entries, obs) => {
          if (entries.some((e) => e.isIntersecting)) { write(); obs.disconnect(); }
        }, { threshold: 0.6 }).observe(reveal.closest('.cs-signoff')!);
      }
    }

    let t: ReturnType<typeof setTimeout>;
    const relayout = () => { clearTimeout(t); t = setTimeout(layout, 150); };
    new ResizeObserver(relayout).observe(content);
    window.addEventListener('resize', relayout);
    layout();
    requestAnimationFrame(frame);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCaseStudyPen);
  } else {
    initCaseStudyPen();
  }
</script>
