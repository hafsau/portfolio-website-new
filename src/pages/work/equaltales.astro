---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import Lead from '../../components/case/Lead.astro';
import ContributionList from '../../components/case/ContributionList.astro';
import ImpactList from '../../components/case/ImpactList.astro';
import RuledList from '../../components/case/RuledList.astro';
import RuledRow from '../../components/case/RuledRow.astro';
import Figure from '../../components/case/Figure.astro';
import CodeTerminal from '../../components/CodeTerminal.astro';

const equalTalesPrompts = [
  "claude: Build a children's storybook generator",
  "claude: Feature real women from history",
  "claude: Create a watercolor illustration style",
  "claude: Add personalization with the child's name"
];

const metrics = [
  { value: '1st', label: 'Place - Best AI/ML at #75HER Hackathon' },
  { value: '200+', label: 'Demo attendees' }
];

const contributions = [
  {
    label: 'Research',
    metrics: [
      { value: '50+', text: 'historical figures researched' },
      { value: '5', text: 'user personas developed' },
      { value: '5', text: 'competitor analysis' }
    ]
  },
  {
    label: 'Design',
    metrics: [
      { value: '12', text: 'story screens designed' },
      { value: '6', text: 'character templates' },
      { value: '1', text: 'illustration style guide' }
    ]
  },
  {
    label: 'Development',
    metrics: [
      { value: '2', text: 'AI models integrated' },
      { value: '1', text: 'deployed MVP' }
    ]
  }
];

const impactPoints = [
  {
    title: 'Identifying the Gap',
    description: 'Recognized that most children\'s books feature male protagonists. Girls need to see themselves as scientists, engineers, and leaders—not just princesses.'
  },
  {
    title: 'Choosing Authenticity',
    description: 'Used real historical women like Marie Curie and Mae Jemison instead of fictional characters. Real stories create real impact.'
  },
  {
    title: 'Visual Consistency',
    description: 'Developed a watercolor illustration style that creates cohesive, warm visuals across all generated images—solving the AI inconsistency problem.'
  },
  {
    title: 'Personal Connection',
    description: 'Wove the child\'s name directly into the narrative, transforming a generic story into a personal adventure.'
  }
];

const designEvolution = {
  triedAndFailed: [
    'Generating unique characters per story—faces were inconsistent across pages',
    'Using photorealistic image style—uncanny valley effect',
    'Generic fictional role models—felt hollow without authenticity'
  ],
  whatWorked: [
    'Real historical women (Marie Curie, Mae Jemison) for instant authenticity',
    'Watercolor illustration style for cohesive, warm visuals',
    'Child\'s name woven into narrative for emotional connection'
  ]
};

const keyTradeoff = "Chose authenticity over flexibility—real historical figures limit story variety but create deeper emotional impact.";

const outcome = {
  award: "Best AI/ML — #75HER Hackathon",
  reach: "Demo'd to 200+ attendees",
  devpostUrl: "https://devpost.com/software/equaltales"
};

const aboutMePoints = [
  {
    title: 'Mission-Driven Design',
    description: 'I\'m drawn to projects with real-world impact. Closing the STEM gender gap isn\'t just a hackathon theme—it\'s a problem worth solving.'
  },
  {
    title: 'Rapid Prototyping',
    description: 'I took EqualTales from concept to a deployed product for the hackathon. Speed enables experimentation and learning.'
  },
  {
    title: 'AI-Native Thinking',
    description: 'I understand how to leverage AI tools effectively—knowing when to prompt, iterate, and make trade-offs for the best outcome.'
  }
];
---

<CaseStudyLayout
  title="EqualTales"
  subtitle="An AI-powered children's storybook generator featuring real women from history—built for a hackathon with a mission."
  description="AI-generated personalized children's stories featuring historical women role models to inspire the next generation of STEM leaders."
  heroImage="/images/equaltales/hero.png"
  ogImage="/images/og/equaltales.jpg"
  industry="EdTech / Social Impact"
  role="Designer & Developer"
  timeline="2026 (#75HER Hackathon)"
  platforms="Web"
  tools={[]}
  metrics={metrics}
  prevProject={{ title: 'PixelCheck', href: '/work/pixelcheck' }}
  nextProject={{
    title: 'Philly Truce',
    href: '/work/philly-truce',
    subtitle: 'Brand and design system for a community-safety nonprofit',
    image: '/images/philly-truce/hero.png'
  }}
>
  <!-- Top CTA -->
  <section class="case-section cta-section-top">
    <a href="https://equaltales.vercel.app/" target="_blank" rel="noopener noreferrer" class="cta-button">
      Try EqualTales
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
    </a>
  </section>

  <!-- Terminal Animation -->
  <section class="case-section terminal-section">
    <Figure bare caption="This is how it starts. A question, a prompt, and curiosity.">
      <CodeTerminal prompts={equalTalesPrompts} />
    </Figure>
  </section>

  <!-- Section: Problem Statement -->
  <section class="case-section">
    <h2>The Challenge</h2>
    <div class="problem-statement">
      <p class="lead-text">
        A hackathon challenge with a mission: create something that helps close the gender gap in STEM.
      </p>
      <p class="lead-text secondary">
        Research shows that representation matters. Girls who see women in STEM are more likely to pursue those careers themselves.
      </p>
      <Lead label="The Question">
        <p>
          Can AI create <strong>meaningful children's content</strong> that challenges stereotypes and inspires young girls to see themselves as scientists, engineers, and leaders?
        </p>
      </Lead>
    </div>
  </section>

  <!-- Section: My Contributions -->
  <section class="case-section">
    <h2>My Contributions</h2>
    <ContributionList contributions={contributions} />
  </section>

  <!-- Section: How I Made an Impact -->
  <section class="case-section">
    <h2>How I Made an Impact</h2>
    <ImpactList points={impactPoints} />
  </section>

  <!-- Product Gallery -->
  <section class="case-section">
    <h2>The Product</h2>
    <Figure n={1} caption="Landing Page">
      <img src="/images/equaltales/hero.webp" alt="EqualTales landing page - AI-powered stories that change what children believe is possible" loading="lazy" />
    </Figure>
    <Figure n={2} caption="Stereotype Input">
      <img src="/images/equaltales/equaltales-selection.webp" alt="Stereotype selection screen - Type the stereotype your child has expressed" loading="lazy" />
    </Figure>
    <Figure n={3} caption="Historical Figures">
      <img src="/images/equaltales/equaltales-historical-figure.webp" alt="Historical figure selection - Real women who broke barriers" loading="lazy" />
    </Figure>
    <Figure n={4} caption="Generated Story">
      <img src="/images/equaltales/equaltales-storytelling.webp" alt="AI-generated personalized story with watercolor illustrations" loading="lazy" />
    </Figure>
  </section>

  <!-- Section: Design Evolution -->
  <section class="case-section">
    <h2>Design Evolution</h2>
    <p>
      Building with AI requires iteration. Here's what I learned through trial and error:
    </p>

    <RuledList compare label="Design evolution">
      <RuledRow>
        <Fragment slot="a">
          <h3 class="evo-heading">What I Tried That Didn't Work</h3>
          <ul class="evo-list">
            {designEvolution.triedAndFailed.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </Fragment>
        <Fragment slot="b">
          <h3 class="evo-heading">What Actually Worked</h3>
          <ul class="evo-list">
            {designEvolution.whatWorked.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </Fragment>
      </RuledRow>
    </RuledList>
  </section>

  <!-- Section: Visual Direction -->
  <section class="case-section">
    <h2>Visual Direction</h2>
    <p>
      The watercolor illustration style was a deliberate choice to solve AI's consistency problem while creating warm, inviting visuals.
    </p>

    <RuledList label="Visual direction">
      <RuledRow label="Art Style" title="Watercolor">
        <p>Soft, warm, forgiving of AI inconsistencies</p>
      </RuledRow>
      <RuledRow label="Palette">
        <div class="color-swatches" aria-hidden="true">
          <span class="swatch" style="background: #7B5EA7"></span>
          <span class="swatch" style="background: #C4766D"></span>
          <span class="swatch" style="background: #D4A853"></span>
          <span class="swatch" style="background: #FDF6ED"></span>
        </div>
        <p>Purple, coral, gold on warm cream</p>
      </RuledRow>
      <RuledRow label="Characters" title="Historical">
        <p>Real women, real stories</p>
      </RuledRow>
    </RuledList>
  </section>

  <!-- Section: Key Trade-off -->
  <section class="case-section">
    <h2>Key Trade-off</h2>
    <Lead label="What I chose">
      <p>{keyTradeoff}</p>
    </Lead>
    <p class="tradeoff-explanation">
      By anchoring stories to real historical figures, we limited the variety of narratives we could tell. But the authenticity of real women's achievements—Marie Curie discovering radium, Mae Jemison traveling to space—creates a deeper emotional impact than any fictional character could.
    </p>
  </section>

  <!-- Section: Outcome -->
  <section class="case-section outcome-section">
    <h2>Outcome</h2>
    <RuledList label="Outcome">
      <RuledRow label="Recognition">
        <p class="outcome-value">{outcome.award}</p>
      </RuledRow>
      <RuledRow label="Impact">
        <p class="outcome-value">{outcome.reach}</p>
      </RuledRow>
    </RuledList>
    <p class="outcome-note">
      The judges recognized that EqualTales wasn't just a technical achievement—it was a meaningful application of AI to address a real social challenge.
    </p>
    <div class="outcome-link">
      <a href={outcome.devpostUrl} target="_blank" rel="noopener noreferrer" class="devpost-link">
        View on Devpost
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15 3 21 3 21 9"/>
          <line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Section: What This Shows About Me -->
  <section class="case-section conclusion">
    <h2>What This Shows About Me</h2>
    <p class="conclusion-intro">
      This project demonstrates my ability to combine design thinking, AI tools, and social impact into a cohesive product under extreme time pressure.
    </p>

    <ImpactList points={aboutMePoints} />
  </section>

  <!-- CTA -->
  <section class="case-section cta-section">
    <a href="https://equaltales.vercel.app/" target="_blank" rel="noopener noreferrer" class="cta-button">
      Try EqualTales
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
    </a>
  </section>
</CaseStudyLayout>

<style>
  /* EqualTales color palette */
  :root {
    --color-accent: #7B5EA7;
    --color-accent-text: #a98fd4; /* purple tint for small text on dark: 6.3:1+ (WCAG AA) */
    --equaltales-purple: #7B5EA7;
    --equaltales-coral: #C4766D;
    --equaltales-gold: #D4A853;
    --equaltales-cream: #FDF6ED;
  }

  /* Terminal Section */
  .terminal-section {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  /* Problem Statement */
  .problem-statement {
    margin-top: 1rem;
  }

  .lead-text {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .lead-text.secondary {
    margin-top: 0.75rem;
    font-weight: 500;
    color: var(--color-fg);
  }

  /* Design Evolution: two columns in one ruled row */
  :global(.case-content) .evo-heading {
    margin: 0 0 0.75rem;
    font: 500 11px/1.4 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  :global(.case-content) .evo-list {
    margin: 0;
  }

  :global(.case-content) .evo-list li {
    color: var(--color-fg);
  }

  /* Visual Direction palette */
  .color-swatches {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .swatch {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-fg) 12%, transparent);
  }

  /* Trade-off */
  :global(.case-content) .tradeoff-explanation {
    margin-top: 1.25rem;
    color: var(--color-muted);
    line-height: 1.6;
  }

  /* Outcome */
  :global(.case-content) .outcome-value {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-fg);
  }

  .outcome-link {
    margin-top: 1.5rem;
  }

  .devpost-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-accent-text);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .devpost-link:hover {
    color: var(--equaltales-coral);
    text-decoration: underline;
  }

  :global(.case-content) .outcome-note {
    margin-top: 1.5rem;
    color: var(--color-muted);
  }

  /* Conclusion / What This Shows About Me */
  .conclusion {
    border-top: 1px solid var(--color-border);
    padding-top: 3rem;
  }

  .conclusion-intro {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  /* Top CTA Section */
  .cta-section-top {
    text-align: center;
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
    border-bottom: none;
  }

  .cta-section-top .cta-button {
    margin-top: 0;
  }

  /* Bottom CTA Section */
  .cta-section {
    text-align: center;
    padding-top: 2rem;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    background: var(--color-accent);
    color: white;
    text-decoration: none;
    border-radius: 0.5rem;
    font-weight: 600;
    transition: background-color 0.2s ease;
  }

  .cta-button:hover {
    background: color-mix(in srgb, var(--color-accent) 82%, black);
  }

  /* Section styling */
  .case-section {
    padding-bottom: 3rem;
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--color-border);
  }

  .case-section:last-of-type {
    border-bottom: none;
    margin-bottom: 0;
  }

  /* Remove border from outcome section since conclusion has border-top */
  .outcome-section {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .case-section > h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-fg);
    margin: 0 0 0.75rem 0;
    letter-spacing: -0.02em;
  }

  .case-section > h2::after {
    content: '';
    display: block;
    width: 40px;
    height: 3px;
    background: var(--color-accent);
    margin-top: 0.75rem;
    margin-bottom: 1.5rem;
    border-radius: 2px;
  }

  .case-section > p {
    color: var(--color-muted);
    line-height: 1.6;
  }
</style>
