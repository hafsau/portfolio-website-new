---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import Lead from '../../components/case/Lead.astro';
import ContributionList from '../../components/case/ContributionList.astro';
import ImpactList from '../../components/case/ImpactList.astro';
import RuledList from '../../components/case/RuledList.astro';
import RuledRow from '../../components/case/RuledRow.astro';
import DisplayNumeral from '../../components/case/DisplayNumeral.astro';

const metrics = [
  { value: '21% → 91%', label: 'Medical officer attendance increase' },
  { value: '4,000+', label: 'Medical officers monitored' },
  { value: '3M', label: 'Children\'s records digitized' }
];

const contributions = [
  {
    label: 'Research',
    metrics: [
      { value: '3', text: 'government departments' },
      { value: '36', text: 'districts analyzed' },
      { value: '4,000+', text: 'medical officers studied' },
      { value: '2', text: 'pilot programs run' }
    ]
  },
  {
    label: 'Leadership',
    metrics: [
      { value: '3', text: 'departments coordinated' },
      { value: '1', text: 'CM Roadmap Team partnership' },
      { value: '£250k', text: 'DFID funding secured' },
      { value: '2', text: 'major products delivered' }
    ]
  },
  {
    label: 'Impact',
    metrics: [
      { value: '+70 pts', text: 'medical officer attendance' },
      { value: '3M', text: 'children\'s records digitized' },
      { value: '36', text: 'districts deployed' },
      { value: '4,000+', text: 'officers monitored' }
    ]
  }
];

const impactPoints = [
  {
    title: 'Two Products, One Mission',
    description: 'Led development of eVaccs 2.0 for real-time monitoring AND redesigned the national Child Vaccination Card with a companion Android app—digitizing records for 3 million children.'
  },
  {
    title: 'Designing for Constraints',
    description: 'Users had low literacy, basic phones, and spotty connectivity. Advocated for radical simplicity: one tap, GPS verification, offline-first. No typing required.'
  },
  {
    title: 'Cross-Department Coordination',
    description: 'Worked with Health, Irrigation, and Education departments plus the Chief Minister\'s Roadmap Team—gathering requirements, developing action plans, and meeting deadlines across multiple stakeholder groups.'
  },
  {
    title: 'Securing International Funding',
    description: 'The Child Vaccination Card project was awarded £250k by DFID (UK Department for International Development)—validating our approach and enabling province-wide rollout.'
  }
];

const constraints = [
  {
    constraint: 'Low Literacy',
    detail: 'Many medical officers couldn\'t read — interfaces had to rely on icons, colors, and visual cues instead of text'
  },
  {
    constraint: 'Basic Devices',
    detail: 'Low-end Android phones with limited memory and processing power — every feature had to be lightweight'
  },
  {
    constraint: 'Unreliable Connectivity',
    detail: 'Rural areas with spotty network coverage — the app needed to work offline and sync when possible'
  },
  {
    constraint: 'Minimal Training',
    detail: 'No time for extensive onboarding — the interface had to be intuitive from first use'
  },
  {
    constraint: 'Resistance to Monitoring',
    detail: 'Medical officers were wary of surveillance — the tool needed to feel helpful, not punitive'
  }
];

const designDecisions = [
  {
    title: 'Single-Tap Check-In',
    description: 'The core interaction was one tap at each vaccination site. GPS verification confirmed location automatically — no manual entry needed. Under 30 seconds per stop.'
  },
  {
    title: 'Visual-First Interface',
    description: 'Icons and color-coding replaced text wherever possible. Green checkmarks for completed stops, red alerts for missed ones. The interface worked for users who couldn\'t read.'
  },
  {
    title: 'Offline-First Architecture',
    description: 'All data stored locally and synced when connectivity was available. Essential for rural areas where network coverage was unpredictable.'
  },
  {
    title: 'Real-Time Supervisor Dashboard',
    description: 'District supervisors could see live maps of medical officer locations, identify non-compliance immediately, and dispatch follow-ups the same day.'
  }
];

const learnings = [
  {
    title: 'Context beats features',
    description: 'The most sophisticated solution would have failed here. What worked was radical simplicity designed for real-world constraints.'
  },
  {
    title: 'Cross-department work requires translation',
    description: 'Working with Health, Irrigation, Education, and the CM Roadmap Team meant constantly translating technical capabilities into policy outcomes.'
  },
  {
    title: 'International funding validates approach',
    description: 'Securing £250k from DFID proved our methodology was sound—external validation that opened doors for province-wide expansion.'
  }
];

const stakeholders = [
  {
    title: 'Chief Minister Office',
    description: 'Prepared data-driven presentations demonstrating ROI and public health impact. Secured executive sponsorship for province-wide rollout.'
  },
  {
    title: 'World Bank (PPMR Program)',
    description: 'Aligned project outcomes with funding requirements. Demonstrated measurable results that justified additional budget allocation.'
  },
  {
    title: 'District Health Officers',
    description: 'Trained supervisors on dashboard usage and established feedback loops for continuous improvement.'
  }
];

const results = [
  {
    value: '21% → 91%',
    label: 'Medical Officer Attendance',
    description: 'Real-time GPS tracking created accountability that paper reports never could'
  },
  {
    value: '3M',
    label: 'Children\'s Records Digitized',
    description: 'National Child Vaccination Card redesign enabled province-wide digital records'
  },
  {
    value: '£250k',
    label: 'DFID Funding Awarded',
    description: 'International validation of our approach from UK Department for International Development'
  }
];
const [headlineResult, ...otherResults] = results;

const aboutMe = [
  {
    title: 'Cross-Functional Leadership',
    description: 'Led development of two major products (eVaccs 2.0 and Child Vaccination Card app) coordinating across Health, Irrigation, and Education departments.'
  },
  {
    title: 'Designing for Constraints',
    description: 'Advocated for radical simplicity based on user research. The solution worked because it was designed for real-world limitations, not ideal conditions.'
  },
  {
    title: 'Stakeholder Management',
    description: 'Worked with CM Roadmap Team consultants, secured £250k DFID funding, and coordinated requirements gathering across multiple government departments.'
  },
  {
    title: 'Measurable Impact at Scale',
    description: 'Delivered results that mattered: medical officer attendance up from 21% to 91%, 3 million children\'s records digitized, 4,000+ medical officers monitored.'
  }
];
---

<CaseStudyLayout
  title="Immunization Tracker"
  subtitle="I led the redesign and development of eVaccs 2.0—a mobile monitoring system that transformed child vaccination coverage across Punjab, Pakistan's most populous province, increasing medical officer attendance from 21% to 91%."
  description="Led development of eVaccs 2.0 and the national Child Vaccination Card digitization, monitoring 4,000+ medical officers and digitizing records for 3 million children."
  heroImage="/images/immunization/hero-image.png"
  ogImage="/images/og/immunization.jpg"
  industry="Public Health"
  role="Assistant Program Manager"
  timeline="2014-2015"
  platforms="Android Mobile, Web Dashboard"
  tools={[]}
  metrics={metrics}
  prevProject={{ title: 'Folio', href: '/work/folio' }}
  nextProject={{
    title: 'PixelCheck',
    href: '/work/pixelcheck',
    subtitle: 'Holding AI-built UI to the designer\'s frames',
    image: '/images/pixelcheck/hero.png'
  }}
>
  <!-- Section: The Challenge -->
  <section class="case-section">
    <h2>The Challenge</h2>
    <div class="problem-statement">
      <p class="lead-text">
        Child immunization in Punjab—Pakistan's most populous province—was failing. Only 21% of the 4,000+ medical officers were showing up to their assigned routes, and there was no way to track field activities.
      </p>
      <p class="lead-text secondary">
        Paper-based reporting was unreliable, easily falsified, and arrived weeks late. Meanwhile, children's vaccination records existed only on paper cards that were frequently lost or damaged.
      </p>
      <Lead label="The Problem">
        <p>
          The government needed <strong>real-time visibility into field operations</strong> and a way to digitize immunization records for millions of children—a dual challenge requiring coordination across Health, Irrigation, and Education departments.
        </p>
      </Lead>
    </div>
  </section>

  <!-- Section: My Contributions -->
  <section class="case-section">
    <h2>My Contributions</h2>
    <ContributionList contributions={contributions} />
  </section>

  <!-- Section: How I Made an Impact -->
  <section class="case-section">
    <h2>How I Made an Impact</h2>
    <ImpactList points={impactPoints} />
  </section>

  <!-- Section: Understanding Constraints -->
  <section class="case-section">
    <h2>Understanding Constraints</h2>
    <p class="section-intro">
      Before building anything, we needed to understand our users—medical officers in rural areas with very different contexts than our own:
    </p>

    <RuledList label="Constraints">
      {constraints.map(item => (
        <RuledRow title={item.constraint}>
          <p>{item.detail}</p>
        </RuledRow>
      ))}
    </RuledList>
  </section>

  <!-- Section: Decisions in detail -->
  <section class="case-section">
    <h2>Decisions in detail</h2>
    <p>
      Based on field research and stakeholder needs, we advocated for these core product decisions:
    </p>

    <RuledList label="Product decisions">
      {designDecisions.map(decision => (
        <RuledRow title={decision.title}>
          <p>{decision.description}</p>
        </RuledRow>
      ))}
    </RuledList>
  </section>

  <!-- Section: Stakeholder Management -->
  <section class="case-section">
    <h2>Stakeholder Management</h2>
    <blockquote>
      <p>
        "A critical part of this project was navigating government bureaucracy—translating technical capabilities into policy outcomes that politicians and bureaucrats could understand and champion."
      </p>
    </blockquote>

    <RuledList label="Stakeholders">
      {stakeholders.map(stakeholder => (
        <RuledRow title={stakeholder.title}>
          <p>{stakeholder.description}</p>
        </RuledRow>
      ))}
    </RuledList>
  </section>

  <!-- Section: Results -->
  <section class="case-section">
    <h2>Results</h2>
    <p>
      The impact was dramatic and measurable:
    </p>

    <DisplayNumeral
      value={headlineResult.value}
      label={headlineResult.label}
      note={headlineResult.description}
    />

    <RuledList label="Other results" class="results-list">
      {otherResults.map(result => (
        <RuledRow label={result.value} title={result.label}>
          <p>{result.description}</p>
        </RuledRow>
      ))}
    </RuledList>
  </section>

  <!-- Section: Reflection -->
  <section class="case-section">
    <h2>Reflection</h2>
    <blockquote>
      <p>
        "This project taught me that great design isn't about features—it's about understanding constraints and designing within them. The technology was invisible; the outcome was what mattered."
      </p>
    </blockquote>

    <RuledList label="Learnings">
      {learnings.map(learning => (
        <RuledRow title={learning.title}>
          <p>{learning.description}</p>
        </RuledRow>
      ))}
    </RuledList>
  </section>

  <!-- Section: What This Shows About Me -->
  <section class="case-section conclusion">
    <h2>What This Shows About Me</h2>
    <p class="conclusion-intro">
      This project demonstrates my ability to lead complex, high-stakes initiatives from concept to scale—working with diverse stakeholders, constrained environments, and real-world impact.
    </p>

    <RuledList label="What this shows">
      {aboutMe.map(point => (
        <RuledRow title={point.title}>
          <p>{point.description}</p>
        </RuledRow>
      ))}
    </RuledList>
  </section>
</CaseStudyLayout>

<style>
  /* Section styling */
  .case-section {
    margin-bottom: 5rem;
  }

  .case-section.no-margin {
    margin-bottom: 0;
  }

  .section-intro {
    font-size: 1.0625rem;
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  /* Problem Statement */
  .problem-statement {
    margin-top: 1.5rem;
  }

  .lead-text {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-muted);
  }

  .lead-text.secondary {
    margin-top: 1rem;
    font-weight: 500;
    color: var(--color-fg);
  }

  /* Results: the figure is the row label, kept in its own case (e.g. £250k) */
  :global(.case-content .results-list .rr-label) {
    font-size: 0.9375rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-fg);
  }

  /* Conclusion */
  .conclusion {
    border-top: 1px solid var(--color-border);
    padding-top: 3rem;
  }

  .conclusion-intro {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  /* ========================================
     SECTION & HEADING STYLES
     ======================================== */
  .case-section {
    padding-bottom: 3rem;
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--color-border);
  }

  .case-section:last-of-type {
    border-bottom: none;
    margin-bottom: 0;
  }

  .case-section > h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-fg);
    margin: 0 0 0.75rem 0;
    letter-spacing: -0.02em;
  }

  .case-section > h2::after {
    content: '';
    display: block;
    width: 40px;
    height: 3px;
    background: var(--color-accent);
    margin-top: 0.75rem;
    margin-bottom: 1.5rem;
    border-radius: 2px;
  }

  .case-section h3 {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-fg);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 1.5rem 0 0.75rem 0;
  }

  .case-section img {
    max-width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: contain;
    border-radius: 0.5rem;
    display: block;
    margin: 1rem auto;
  }
</style>
